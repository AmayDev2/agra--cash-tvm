<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>

<AnchorPane fx:id="mainRootPane" prefHeight="480.0" prefWidth="640.0" style="-fx-background-color: #fff;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.amay.tom.pdu.controller.PDUController">
   <children>
       <GridPane prefHeight="480.0" prefWidth="640.0">
           <columnConstraints>
               <ColumnConstraints halignment="CENTER" hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0"/>
           </columnConstraints>
           <rowConstraints>
               <RowConstraints minHeight="0.0" percentHeight="0.0" prefHeight="0.0" vgrow="SOMETIMES"/>
               <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
               <RowConstraints minHeight="10.0" percentHeight="15.0" prefHeight="30.0" vgrow="SOMETIMES"/>
           </rowConstraints>
           <StackPane fx:id="stackPane" style=" -fx-background-color: #CCE4FF;" alignment="TOP_CENTER"
                      GridPane.columnIndex="0" GridPane.rowIndex="1">
               <!--                  <fx:include source="success_screen.fxml" />-->
               <!--                  <fx:include source="error_screen.fxml" />-->
               <!--                  <fx:include source="emergency_screen.fxml" />-->
               <fx:include source="welcome_screen.fxml"/>
           </StackPane>
           <fx:include source="footer.fxml" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
       </GridPane>
   </children>
</AnchorPane>
