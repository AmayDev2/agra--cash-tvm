<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.RowConstraints?>

<GridPane prefHeight="480.0" prefWidth="640.0" styleClass="background" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.amay.tom.pdu.controller.MoneyManagementBnrUnloadController">

    <!-- Columns -->
    <columnConstraints>
        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" />
    </columnConstraints>

    <!-- Rows -->
    <rowConstraints>
        <RowConstraints maxHeight="154.0" minHeight="0.0" percentHeight="20.0" prefHeight="0.0" vgrow="SOMETIMES" />
        <RowConstraints maxHeight="320.0" minHeight="10.0" percentHeight="35.0" prefHeight="320.0" vgrow="SOMETIMES" />
        <RowConstraints maxHeight="320.0" minHeight="10.0" percentHeight="15.0" prefHeight="320.0" vgrow="SOMETIMES" />
      <RowConstraints maxHeight="320.0" minHeight="10.0" percentHeight="15.0" prefHeight="320.0" vgrow="SOMETIMES" />
        <RowConstraints minHeight="10.0" percentHeight="15.0" prefHeight="30.0" vgrow="SOMETIMES" />
    </rowConstraints>

    <!-- Buttons R1-R4 -->
    <GridPane GridPane.rowIndex="2">
        <columnConstraints>
            <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
            <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
        </columnConstraints>
        <rowConstraints>
            <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
        </rowConstraints>

        <Button mnemonicParsing="false" onAction="#onR4" styleClass="navigatorButton" stylesheets="@styles.css" text="R4" GridPane.halignment="CENTER" />
        <Button mnemonicParsing="false" onAction="#onR3" styleClass="navigatorButton" stylesheets="@styles.css" text="R3" GridPane.columnIndex="1" GridPane.halignment="CENTER" />
    </GridPane>

    <!-- Placeholder FlowPane -->
    <FlowPane GridPane.rowIndex="1" />

    <!-- Back Button -->
    <Button mnemonicParsing="false" onAction="#onBackBnr" styleClass="backButton" stylesheets="@styles.css" text="Back" GridPane.columnSpan="1" GridPane.halignment="CENTER" GridPane.rowIndex="4" />

    <!-- Bottom GridPane: Empty Cashbox and Last Ejected -->
    <GridPane>
        <columnConstraints>
            <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
        </columnConstraints>
        <rowConstraints>
            <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
            <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
        </rowConstraints>

        <Button onAction="#onBnrUnLoad" prefHeight="39.0" prefWidth="194.0" text="Empty Cashbox" visible="false" GridPane.halignment="CENTER" />
        <Label fx:id="totalAmount" styleClass="label-header" stylesheets="@styles.css" text="RECYCLERS AMOUNT : " GridPane.halignment="CENTER" GridPane.rowIndex="1" />
    </GridPane>
   <GridPane GridPane.rowIndex="3">
     <columnConstraints>
       <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
       <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
     </columnConstraints>
     <rowConstraints>
       <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
     </rowConstraints>
      <children>
           <Button mnemonicParsing="false" onAction="#onR2" styleClass="navigatorButton" stylesheets="@styles.css" text="R2" GridPane.halignment="CENTER" />
           <Button mnemonicParsing="false" onAction="#onR1" styleClass="navigatorButton" stylesheets="@styles.css" text="R1" GridPane.columnIndex="1" GridPane.halignment="CENTER" />
      </children>
   </GridPane>

</GridPane>
