<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.RowConstraints?>

<GridPane prefWidth="640.0" styleClass="background" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.amay.tom.pdu.controller.MoneyManagementBnrUnloadController">

    <!-- Columns -->
    <columnConstraints>
        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" />
    </columnConstraints>

    <!-- Rows -->
    <rowConstraints>
        <RowConstraints maxHeight="154.0" minHeight="0.0" percentHeight="25.0" prefHeight="0.0" vgrow="SOMETIMES" />
        <RowConstraints maxHeight="320.0" minHeight="10.0" percentHeight="45.0" prefHeight="320.0" vgrow="SOMETIMES" />
        <RowConstraints maxHeight="400.0" minHeight="10.0" percentHeight="40.0" prefHeight="400.0" vgrow="SOMETIMES" />
        <RowConstraints minHeight="10.0" percentHeight="15.0" prefHeight="30.0" vgrow="SOMETIMES" />
    </rowConstraints>

    <!-- Buttons R1-R4 -->
    <GridPane GridPane.rowIndex="2">
        <columnConstraints>
            <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
            <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
        </columnConstraints>
        <rowConstraints>
            <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
         <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
        </rowConstraints>

        <Button mnemonicParsing="false" onAction="#onR4" styleClass="navigatorButton" text="R4(100)" GridPane.halignment="CENTER" />
        <Button mnemonicParsing="false" onAction="#onR3" styleClass="navigatorButton" text="R3(50)" GridPane.columnIndex="1" GridPane.halignment="CENTER" />
        <Button mnemonicParsing="false" onAction="#onR2" styleClass="navigatorButton" text="R2(10)" GridPane.columnIndex="1" GridPane.halignment="CENTER" GridPane.rowIndex="1" />
        <Button mnemonicParsing="false" onAction="#onR1" styleClass="navigatorButton" text="R1(20)" GridPane.halignment="CENTER" GridPane.rowIndex="1" />
    </GridPane>

    <!-- Placeholder FlowPane -->
    <FlowPane prefHeight="200.0" prefWidth="200.0" styleClass="maintenance-label-header" GridPane.rowIndex="1" />

    <!-- Back Button -->
    <Button mnemonicParsing="false" onAction="#onBackBnr" prefHeight="39.0" prefWidth="150.0" styleClass="backButton" text="Back" GridPane.columnSpan="1" GridPane.halignment="CENTER" GridPane.rowIndex="3" />

       <!-- Bottom GridPane: Empty Cashbox and Last Ejected -->
    <GridPane>
        <columnConstraints>
            <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
        </columnConstraints>
        <rowConstraints>
            <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
            <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
        </rowConstraints>

           <Button onAction="#onBnrUnLoad" prefHeight="39.0" prefWidth="194.0" text="Empty Cashbox" visible="false" GridPane.halignment="CENTER" />
        <Label fx:id="totalAmount" styleClass="maintenance-label-header" text="RECYCLERS AMOUNT : " GridPane.halignment="CENTER" GridPane.rowIndex="1" />
    </GridPane>

</GridPane>
