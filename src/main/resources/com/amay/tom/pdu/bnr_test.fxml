<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<GridPane alignment="CENTER" hgap="15" style="-fx-background-color: #f5f5f5; -fx-padding: 20;" vgap="20" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.amay.tom.pdu.controller.BNRTestController">

    <!-- Auto-fit to parent -->
    <columnConstraints>
        <ColumnConstraints halignment="CENTER" hgrow="ALWAYS" percentWidth="10.0" />
        <ColumnConstraints halignment="CENTER" hgrow="ALWAYS" percentWidth="35.0" />
        <ColumnConstraints halignment="CENTER" hgrow="ALWAYS" percentWidth="35.0" />
        <ColumnConstraints halignment="CENTER" hgrow="ALWAYS" percentWidth="10.0" />
    </columnConstraints>

    <rowConstraints>
        <RowConstraints percentHeight="10" vgrow="NEVER" />
        <RowConstraints percentHeight="20" vgrow="ALWAYS" />
        <RowConstraints percentHeight="20" vgrow="ALWAYS" />
        <RowConstraints percentHeight="20" vgrow="ALWAYS" />
        <RowConstraints percentHeight="20" vgrow="ALWAYS" />
        <RowConstraints percentHeight="10" vgrow="NEVER" />
    </rowConstraints>

    <!-- Title -->
    <Label style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #333;" text="BNR Test" GridPane.columnSpan="4" GridPane.halignment="CENTER" GridPane.rowIndex="0" />

    <!-- Buttons Row -->
    <Button fx:id="cashInButton" onAction="#onCashInStart" styleClass="primary-btn" text="Cash In Start" GridPane.columnIndex="1" GridPane.rowIndex="2" />

    <Button fx:id="cashEndButton" onAction="#onCashInEnd" styleClass="primary-btn" text="Cash End" GridPane.columnIndex="1" GridPane.rowIndex="1" />

    <Button fx:id="rolloutButton" onAction="#onRollback" styleClass="primary-btn" text="Rollout" GridPane.columnIndex="2" GridPane.rowIndex="1" />

    <Button onAction="#onCancel" styleClass="primary-btn" text="Cancel" GridPane.columnIndex="2" GridPane.rowIndex="2" />

    <!-- Back Button (Bottom Row) -->
    <Button fx:id="btnBack" maxWidth="200" onAction="#onBack" styleClass="primary-btn" text="Back" GridPane.columnSpan="4" GridPane.halignment="CENTER" GridPane.rowIndex="5" />

</GridPane>
