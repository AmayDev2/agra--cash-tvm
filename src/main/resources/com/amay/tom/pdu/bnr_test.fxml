<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.RowConstraints?>

<GridPane alignment="CENTER" prefHeight="480.0" prefWidth="640.0" styleClass="background" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.amay.tom.pdu.controller.BNRTestController">

    <!-- Auto-fit to parent -->
    <columnConstraints>
        <ColumnConstraints halignment="CENTER" hgrow="ALWAYS" percentWidth="50.0" />
        <ColumnConstraints halignment="CENTER" hgrow="ALWAYS" percentWidth="50.0" />
    </columnConstraints>

    <rowConstraints>
        <RowConstraints percentHeight="15.0" vgrow="NEVER" />
        <RowConstraints percentHeight="20.0" vgrow="ALWAYS" />
        <RowConstraints percentHeight="20.0" vgrow="ALWAYS" />
        <RowConstraints percentHeight="45.0" vgrow="NEVER" />
    </rowConstraints>
   <Label styleClass="maintenance-label-heading" text="BNR Test" GridPane.columnSpan="2147483647" />

    <Button fx:id="cashEndButton" onAction="#onCashInEnd" prefHeight="39.0" prefWidth="190.0" styleClass="navigatorButton" text="Cash End" GridPane.halignment="CENTER" GridPane.rowIndex="1" />

    <Button fx:id="rolloutButton" onAction="#onRollback" prefHeight="39.0" prefWidth="190.0" styleClass="navigatorButton" text="Rollout" GridPane.columnIndex="1" GridPane.halignment="CENTER" GridPane.rowIndex="1" />

    <!-- Buttons Row -->
    <Button fx:id="cashInButton" onAction="#onCashInStart" prefHeight="39.0" prefWidth="190.0" styleClass="navigatorButton" text="Cash In Start" GridPane.halignment="CENTER" GridPane.rowIndex="2" />

    <Button fx:id="cancelButton" onAction="#onCancel" prefHeight="39.0" prefWidth="190.0" styleClass="navigatorButton" text="Cancel" GridPane.columnIndex="1" GridPane.halignment="CENTER" GridPane.rowIndex="2" />
   <Button fx:id="backButton" mnemonicParsing="false" onAction="#onBack" prefHeight="39.0" prefWidth="150.0" styleClass="backButton" text="Back" GridPane.columnSpan="2147483647" GridPane.rowIndex="3" GridPane.valignment="CENTER">
      <GridPane.margin>
         <Insets />
      </GridPane.margin></Button>

</GridPane>
