<GridPane alignment="CENTER" styleClass="background"  prefWidth="640.0" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.amay.tom.pdu.controller.SystemInfoController">

    <!-- Columns -->
    <columnConstraints>
        <ColumnConstraints minWidth="10.0" percentWidth="27.0" prefWidth="100.0" />
        <ColumnConstraints minWidth="10.0" percentWidth="20.0" prefWidth="100.0" />
        <ColumnConstraints minWidth="10.0" percentWidth="14.0" prefWidth="100.0" />
        <ColumnConstraints minWidth="10.0" percentWidth="22.0" prefWidth="100.0" />
        <ColumnConstraints minWidth="10.0" percentWidth="12.0" prefWidth="100.0" />
        <ColumnConstraints minWidth="10.0" percentWidth="22.0" prefWidth="100.0" />
        <ColumnConstraints minWidth="10.0" percentWidth="12.0" prefWidth="100.0" />
    </columnConstraints>

    <!-- Rows -->
    <rowConstraints>
        <RowConstraints maxHeight="78.0" minHeight="10.0" percentHeight="12.0" prefHeight="75.0" />
        <RowConstraints maxHeight="57.0" minHeight="47.0" percentHeight="15.0" prefHeight="50.0" />
        <RowConstraints maxHeight="57.0" minHeight="47.0" percentHeight="15.0" prefHeight="50.0" />
