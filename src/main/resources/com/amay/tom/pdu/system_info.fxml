        <RowConstraints percentHeight="15.0" />
        <RowConstraints percentHeight="15.0" />
        <RowConstraints percentHeight="15.0" />
    </rowConstraints>

    <!-- Title -->
    <Label prefHeight="35.0" prefWidth="230.0" text="System Information" GridPane.columnSpan="7" GridPane.halignment="CENTER" GridPane.valignment="CENTER">
        <GridPane.margin>
            <Insets left="20.0" />
        </GridPane.margin>
    </Label>

    <!-- Back Button -->
    <Button minHeight="-Infinity" mnemonicParsing="false" onAction="#onBack" prefHeight="39.0" prefWidth="140.0" text="Back" GridPane.columnSpan="7" GridPane.halignment="CENTER" GridPane.rowIndex="7">
        <GridPane.margin>
            <Insets />
        </GridPane.margin>
    </Button>

    <!-- Labels for Field Names -->
    <Label text="Version Info :" GridPane.halignment="LEFT" GridPane.rowIndex="1" GridPane.valignment="CENTER">
        <GridPane.margin>
            <Insets left="5.0" />
        </GridPane.margin>
    </Label>

    <Label text="Equip Details :" GridPane.halignment="LEFT" GridPane.rowIndex="5" GridPane.valignment="CENTER">
        <GridPane.margin>
            <Insets left="5.0" />
        </GridPane.margin>
    </Label>

    <Label text="BNR Config :" GridPane.halignment="LEFT" GridPane.rowIndex="6" GridPane.valignment="CENTER">
        <GridPane.margin>
            <Insets left="5.0" />
        </GridPane.margin>
    </Label>

    <!-- Version Labels -->
    <Label text="Equip Version" GridPane.columnIndex="1" GridPane.halignment="LEFT" GridPane.rowIndex="1"/>
