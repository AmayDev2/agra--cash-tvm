            <Button fx:id="cancel" mnemonicParsing="false" onAction="#onCancel" prefHeight="39.0" prefWidth="150.0"
                    text="Stop" GridPane.columnIndex="1" GridPane.halignment="CENTER"/>
            <Button fx:id="commit" mnemonicParsing="false" onAction="#onCommit" prefHeight="39.0" prefWidth="150.0"
                    text="Commit" GridPane.columnIndex="2" GridPane.halignment="CENTER"/>
        </GridPane>

        <FlowPane fx:id="flowPaneInsertedNotes" hgap="10"  prefHeight="262.0" prefWidth="640.0" GridPane.rowIndex="1"/>

        <Button mnemonicParsing="false" onAction="#onBackBnr" prefHeight="39.0" prefWidth="150.0" text="Back" GridPane.columnSpan="2147483647" GridPane.halignment="CENTER" GridPane.rowIndex="3" GridPane.rowSpan="2147483647">
            <GridPane.margin>
                <Insets/>
            </GridPane.margin>
        </Button>

        <GridPane>
            <columnConstraints>
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0"/>
            </columnConstraints>
            <rowConstraints>
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
                <RowConstraints minHeight="10.0" percentHeight="35.0" prefHeight="30.0" vgrow="SOMETIMES"/>
            </rowConstraints>
            <children>
                <Button  minHeight="39.0" mnemonicParsing="false" onAction="#onBnrLoad" prefHeight="39.0" prefWidth="150.0" text="BNR Load" GridPane.halignment="CENTER"/>
