<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.RowConstraints?>

<GridPane alignment="CENTER" styleClass="background" stylesheets="@../pdu/styles.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.amay.tom.pdu.controller.ReportController">
    <rowConstraints>
        <RowConstraints percentHeight="10.0" />
        <RowConstraints percentHeight="65.0" />
        <RowConstraints minHeight="10.0" percentHeight="15.0" />
        <RowConstraints percentHeight="15.0" />
    </rowConstraints>

    <!-- Title -->
    <Label styleClass="maintenance-label-heading" text="Report" GridPane.halignment="CENTER" />

    <!-- Table -->
    <TableView fx:id="reportTable" prefHeight="292.0" prefWidth="600.0" GridPane.rowIndex="1">
        <columns>
            <TableColumn fx:id="selectColumn" maxWidth="70.0" minWidth="70.0" prefWidth="70.0" styleClass="sm-radio-cell" text="Select" />
            <TableColumn fx:id="shiftIdColumn" maxWidth="120.0" minWidth="120.0" prefWidth="120.0" text="Shift Id" />
            <TableColumn fx:id="operatorIdColumn" maxWidth="120.0" minWidth="120.0" prefWidth="120.0" text="Operator Id" />
            <TableColumn fx:id="startTimeColumn" maxWidth="130.0" minWidth="130.0" prefWidth="130.0" text="Start Time" />
            <TableColumn fx:id="endTimeColumn" maxWidth="148.0" minWidth="130.0" prefWidth="148.0" text="End Time" />
        </columns>
        <GridPane.margin>
            <Insets left="10.0" right="10.0" />
        </GridPane.margin>
    </TableView>

    <!-- Back Button -->
    <Button fx:id="backbutton" onAction="#onBack" styleClass="backButton" text="Back" GridPane.halignment="CENTER" GridPane.rowIndex="3" />
   <GridPane GridPane.rowIndex="2">
      <GridPane.margin>
         <Insets />
      </GridPane.margin>
      <columnConstraints>
         <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" percentWidth="33.0" />
         <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
         <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
      </columnConstraints>
      <rowConstraints>
         <RowConstraints minHeight="10.0" vgrow="SOMETIMES" />
      </rowConstraints>
      <children>
       <Button fx:id="printButton" onAction="#onClickPrint" styleClass="backButton" text="Print" GridPane.halignment="CENTER" GridPane.valignment="BOTTOM">
    </Button>
           <Button fx:id="balanceQuery" onAction="#onBalance" styleClass="backButton" text="Balance Report" GridPane.columnIndex="2" GridPane.halignment="CENTER" GridPane.valignment="BOTTOM" />

                <Button fx:id="eos" alignment="CENTER" contentDisplay="CENTER" onAction="#onEOS" styleClass="backButton" text="End Current Shift" GridPane.columnIndex="1" GridPane.halignment="CENTER" GridPane.valignment="BOTTOM" />
      </children>
   </GridPane>
   <columnConstraints>
      <ColumnConstraints />
   </columnConstraints>
</GridPane>
