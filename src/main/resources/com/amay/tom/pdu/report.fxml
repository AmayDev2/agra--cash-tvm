<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<GridPane alignment="CENTER" prefHeight="480.0" prefWidth="640.0" stylesheets="/style.css" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.maintenance.ReportController">

    <columnConstraints>
        <ColumnConstraints halignment="CENTER" percentWidth="100.0" />
    </columnConstraints>

    <rowConstraints>
        <RowConstraints percentHeight="10.0" />
        <RowConstraints percentHeight="75.0" />
      <RowConstraints minHeight="10.0" percentHeight="10.0" />
        <RowConstraints percentHeight="15.0" />
    </rowConstraints>

    <children>
        <!-- Title -->
        <Label text="Report" GridPane.columnIndex="0" GridPane.halignment="CENTER" GridPane.rowIndex="0"/>

        <!-- Table -->
        <TableView fx:id="reportTable" prefHeight="292.0" prefWidth="600.0" GridPane.columnIndex="0" GridPane.rowIndex="1">
            <columns>
                <TableColumn fx:id="selectColumn" styleClass="sm-radio-cell" text="Select" />
                <TableColumn fx:id="shiftIdColumn" prefWidth="120.0" text="Shift Id" />
                <TableColumn fx:id="operatorIdColumn" prefWidth="180.0" text="Operator Id" />
                <TableColumn fx:id="startTimeColumn" prefWidth="186.0" text="Start Time" />
                <TableColumn fx:id="endTimeColumn" prefWidth="133.0" text="End Time" />
            </columns>
            <GridPane.margin>
                <Insets left="10.0" right="10.0" />
            </GridPane.margin>
        </TableView>

        <!-- Back Button -->
        <Button onAction="#onBack" prefHeight="39.0" prefWidth="140.0" text="Back" GridPane.halignment="CENTER" GridPane.rowIndex="2"/>
        <Button fx:id="printButton" onAction="#onClickPrint" prefHeight="39.0" prefWidth="140.0"  text="Print" GridPane.halignment="LEFT" GridPane.rowIndex="2">
        </Button>

        <Button fx:id="eos" onAction="#onEOS" prefHeight="39.0" prefWidth="285.0" text="End Current Operational Shift" GridPane.rowIndex="2">

        </Button>
    </children>
</GridPane>
