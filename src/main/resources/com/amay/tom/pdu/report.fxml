<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<GridPane alignment="CENTER" style=" -fx-background-color: #CCE4FF;" prefHeight="480.0" prefWidth="640.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.amay.tom.pdu.controller.ReportController">

    <columnConstraints>
        <ColumnConstraints halignment="CENTER" percentWidth="100.0" />
    </columnConstraints>

    <rowConstraints>
        <RowConstraints percentHeight="10.0" />
        <RowConstraints percentHeight="75.0" />
      <RowConstraints minHeight="10.0" percentHeight="10.0" />
        <RowConstraints percentHeight="15.0" />
    </rowConstraints>

    <children>
        <!-- Title -->
        <Label text="Report" GridPane.columnIndex="0" GridPane.halignment="CENTER" GridPane.rowIndex="0">
            <font>
                <Font name="System Bold" size="24.0" />
            </font>
        </Label>

        <!-- Table -->
        <TableView fx:id="reportTable" prefHeight="292.0" prefWidth="600.0" GridPane.columnIndex="0" GridPane.rowIndex="1">
            <columns>
                <TableColumn fx:id="idColumn" prefWidth="120.0" text="Shift Id" />
                <TableColumn fx:id="operatorIdColumn" prefWidth="180.0" text="Operator Id" />
                <TableColumn fx:id="timeColumn" prefWidth="186.0" text="Time" />
                <TableColumn fx:id="printColumn" prefWidth="133.0" text="Print" />
            </columns>
            <GridPane.margin>
                <Insets left="10.0" right="10.0" />
            </GridPane.margin>
        </TableView>

        <!-- Back Button -->
        <Button onAction="#onBack" prefHeight="39.0" prefWidth="140.0" style="-fx-background-color: gold; -fx-text-fill: black;" text="Back" GridPane.halignment="CENTER" GridPane.rowIndex="3">
            <font>
                <Font name="System Bold" size="18.0" />
            </font>
        </Button>
      <Button fx:id="eos" onAction="#onEOS" prefHeight="39.0" prefWidth="285.0"  style="-fx-background-color: gold; -fx-text-fill: black;" text="End Current Operational Shift" GridPane.rowIndex="2">
         <font>
            <Font name="System Bold" size="18.0" />
         </font>
      </Button>
    </children>
</GridPane>
