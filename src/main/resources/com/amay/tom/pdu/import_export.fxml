<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<GridPane alignment="CENTER" prefHeight="480.0" prefWidth="640.0"  xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.maintenance.ImportExportController">

    <!-- Columns -->
    <columnConstraints>
        <ColumnConstraints halignment="CENTER" minWidth="10.0" percentWidth="50.0" prefWidth="100.0" />
        <ColumnConstraints halignment="CENTER" minWidth="10.0" percentWidth="50.0" prefWidth="100.0" />
    </columnConstraints>

    <!-- Rows -->
    <rowConstraints>
        <RowConstraints minHeight="10.0" percentHeight="17.0" prefHeight="116.0" />
        <RowConstraints minHeight="10.0" percentHeight="20.0" prefHeight="116.0" />
        <RowConstraints minHeight="139.0" percentHeight="35.0" prefHeight="141.0" />
        <RowConstraints minHeight="139.0" percentHeight="35.0" prefHeight="141.0" />
    </rowConstraints>

    <children>
        <!-- Title -->
        <Label prefHeight="35.0" prefWidth="197.0" text="Import & Export" GridPane.columnSpan="2" GridPane.halignment="CENTER" GridPane.valignment="CENTER"/>

        <!-- Buttons -->
        <Button mnemonicParsing="false" onAction="#onImport" prefHeight="35.0" prefWidth="140.0" text="Import" GridPane.halignment="CENTER" GridPane.rowIndex="1" GridPane.valignment="CENTER"/>
        <Button mnemonicParsing="false" onAction="#onExport" prefHeight="35.0" prefWidth="140.0" text="Export" GridPane.columnIndex="1" GridPane.halignment="CENTER" GridPane.rowIndex="1" GridPane.valignment="CENTER"/>
        <Button mnemonicParsing="false" onAction="#onBack" prefHeight="35.0" prefWidth="140.0" text="Back" GridPane.columnSpan="2" GridPane.halignment="CENTER" GridPane.rowIndex="3"/>
    </children>

</GridPane>
