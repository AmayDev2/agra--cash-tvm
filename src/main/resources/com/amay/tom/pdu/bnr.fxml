    </columnConstraints>
    <rowConstraints>
        <RowConstraints percentHeight="35.0" />
        <RowConstraints percentHeight="35.0" />
        <RowConstraints percentHeight="35.0" />
    </rowConstraints>
    <children>
        <Button fx:id="bnrLoadButton" mnemonicParsing="false" onAction="#onBnrLoad" styleClass="navigatorButton" text="BNR Load" GridPane.halignment="CENTER" />
