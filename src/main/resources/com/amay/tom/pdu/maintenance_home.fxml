<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.RowConstraints?>

<GridPane alignment="CENTER" styleClass="background" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.amay.tom.pdu.MaintenanceController">
    <columnConstraints>
        <ColumnConstraints halignment="CENTER" percentWidth="50.0" />
        <ColumnConstraints halignment="CENTER" percentWidth="50.0" />
    </columnConstraints>
    <rowConstraints>
        <RowConstraints percentHeight="25.0" />
        <RowConstraints minHeight="10.0" percentHeight="25.0" valignment="CENTER" />
        <RowConstraints minHeight="100.0" percentHeight="25.0" valignment="CENTER" />
        <RowConstraints minHeight="100.0" percentHeight="25.0" valignment="CENTER" />
    </rowConstraints>

    <Button mnemonicParsing="false" onAction="#onSystemInfo" prefHeight="39.0" prefWidth="210.0" styleClass="navigatorButton" text="System Info" GridPane.halignment="CENTER" />
    <Button mnemonicParsing="false" onAction="#onMoneyManage" prefHeight="35.0" prefWidth="210.0" styleClass="navigatorButton" text="Money Management" GridPane.columnIndex="1" GridPane.halignment="CENTER" />
    <Button mnemonicParsing="false" onAction="#onMain" prefHeight="35.0" prefWidth="210.0" styleClass="navigatorButton" text="Maintenace" GridPane.halignment="CENTER" GridPane.rowIndex="1" />
    <Button mnemonicParsing="false" onAction="#onImpExp" prefHeight="35.0" prefWidth="210.0" styleClass="navigatorButton" text="Data Sync" GridPane.columnIndex="1" GridPane.halignment="CENTER" GridPane.rowIndex="1" />
    <Button alignment="CENTER" contentDisplay="CENTER" mnemonicParsing="false" onAction="#onReports" prefHeight="39.0" prefWidth="200.0" styleClass="navigatorButton" text="Reports" GridPane.columnIndex="0" GridPane.halignment="CENTER" GridPane.rowIndex="2" />
    <Button alignment="CENTER" contentDisplay="CENTER" mnemonicParsing="false" onAction="#onReports" prefHeight="39.0" prefWidth="200.0" styleClass="navigatorButton" text="Reports" GridPane.columnIndex="1" GridPane.rowIndex="2" />
    <Button alignment="CENTER" contentDisplay="CENTER" mnemonicParsing="false" onAction="#onLogout" prefHeight="39.0" prefWidth="200.0" styleClass="navigatorButton" text="Logout" GridPane.columnIndex="0" GridPane.columnSpan="2" GridPane.rowIndex="3" />
</GridPane>
