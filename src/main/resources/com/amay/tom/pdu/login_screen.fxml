<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>


<VBox   maxHeight="Infinity" alignment="CENTER" styleClass="vbox"  stylesheets="@../../../../css/login.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.amay.tom.pdu.controller.MaintenanceLogin" >
        <GridPane alignment="CENTER" hgap="10" vgap="10">
<!--            <Label text="User ID" GridPane.columnIndex="0" GridPane.halignment="RIGHT" GridPane.rowIndex="1">-->
<!--                <font>-->
