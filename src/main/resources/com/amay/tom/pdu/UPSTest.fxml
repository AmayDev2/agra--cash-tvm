    <!-- Center: UPS Info Fields -->
<!--    <center>-->
<!--        <VBox alignment="CENTER" spacing="10" style="-fx-padding: 10;">-->
            <GridPane hgap="10" vgap="2.0">
                <columnConstraints>
                    <ColumnConstraints halignment="CENTER" percentWidth="14.0" />
               <ColumnConstraints halignment="CENTER" minWidth="10.0" percentWidth="14.0" prefWidth="100.0" />
               <ColumnConstraints halignment="CENTER" minWidth="10.0" percentWidth="14.0" prefWidth="100.0" />
               <ColumnConstraints halignment="CENTER" minWidth="10.0" percentWidth="15.0" prefWidth="100.0" />
                    <ColumnConstraints halignment="CENTER" percentWidth="14.0" />
                    <ColumnConstraints halignment="CENTER" percentWidth="14.0" />
                    <ColumnConstraints halignment="CENTER" percentWidth="14.0" />
                </columnConstraints>

                <Label text="I/P volt" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                <Label fx:id="txtInputVoltage" alignment="CENTER" GridPane.rowIndex="2" />

                <Label text="I/P fault volt" GridPane.columnIndex="5" GridPane.rowIndex="0" />
                <Label fx:id="txtInputFaultVoltage" alignment="CENTER" GridPane.columnIndex="5" GridPane.rowIndex="2" />

                <Label text="O/P volt" GridPane.columnIndex="1" />
                <Label fx:id="txtOutputVoltage" alignment="CENTER" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                <Label text="O/P current:" GridPane.columnIndex="4" />
                <Label fx:id="txtOutputCurrent" alignment="CENTER" GridPane.columnIndex="4" GridPane.rowIndex="2" />

                <Label text="I/P freq" GridPane.columnIndex="3" />
                <Label fx:id="txtInputFrequency" alignment="CENTER" GridPane.columnIndex="3" GridPane.rowIndex="2" />

                <Label text="Battery volt" GridPane.columnIndex="6" />
                <Label fx:id="txtBatteryVoltage" alignment="CENTER" GridPane.columnIndex="6" GridPane.rowIndex="2" />

                <Label text="Temp" GridPane.columnIndex="2" />
                <Label fx:id="txtTemperature" alignment="CENTER" text="11" GridPane.columnIndex="2" GridPane.rowIndex="2" />
                <rowConstraints>
                    <RowConstraints />
                    <RowConstraints />
                    <RowConstraints />
                    <RowConstraints />
               <RowConstraints />
                </rowConstraints>
            </GridPane>
