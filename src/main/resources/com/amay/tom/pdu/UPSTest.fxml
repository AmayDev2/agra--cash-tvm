                <columnConstraints>
                    <ColumnConstraints halignment="CENTER" percentWidth="50" />
                    <ColumnConstraints halignment="CENTER" minWidth="10.0" percentWidth="50.0" prefWidth="100.0" />
                    <ColumnConstraints halignment="CENTER" percentWidth="50" />
                    <ColumnConstraints halignment="CENTER" minWidth="10.0" percentWidth="50.0" prefWidth="100.0" />
                </columnConstraints>

                <Label fx:id="lblUtilityNormal" text="Utility Normal" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                <Label fx:id="lblStandbyUPS" text="Standby UPS" GridPane.columnIndex="2" GridPane.rowIndex="0" />

                <Label fx:id="lblBatteryNormal" text="Battery Normal" GridPane.columnIndex="1" />
                <Label fx:id="lblTestProgress" text="Test not in Progress" GridPane.columnIndex="3" />

                <Label fx:id="lblBypass" text="Bypass not Active" GridPane.rowIndex="3" />
                <Label fx:id="lblShutdown" text="Shutdown not Active" GridPane.columnIndex="2" GridPane.rowIndex="3" />

                <Label fx:id="lblUPSNormal" text="UPS Normal" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                <Label fx:id="lblBeeper" text="UPS Beeper Off" GridPane.columnIndex="3" GridPane.rowIndex="3" />

                <rowConstraints>
                    <RowConstraints percentHeight="50.0" />
                    <RowConstraints />
                    <RowConstraints />
                    <RowConstraints percentHeight="50.0" />
                    <RowConstraints />
                    <RowConstraints />
                    <RowConstraints />
                </rowConstraints>
            </GridPane>

