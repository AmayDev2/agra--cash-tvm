<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="TOP_CENTER" spacing="20" style="-fx-background-color: #f5f5f5; -fx-padding: 20;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.amay.tom.pdu.controller.UPSTestController">

    <!-- ===================== UPS Information Section ===================== -->
    <Label style="-fx-font-size: 16px; -fx-font-weight: bold;" text="UPS Live Information" />
    <GridPane alignment="CENTER" hgap="10" style="-fx-background-color: #ffffff;                  -fx-border-color: #cccccc;                  -fx-border-radius: 6;                  -fx-background-radius: 6;                  -fx-padding: 15;" vgap="8">
        <columnConstraints>
            <ColumnConstraints halignment="CENTER" hgrow="ALWAYS" percentWidth="25.0" />
            <ColumnConstraints halignment="CENTER" hgrow="ALWAYS" percentWidth="25.0" />
            <ColumnConstraints halignment="CENTER" hgrow="ALWAYS" percentWidth="25.0" />
            <ColumnConstraints halignment="CENTER" hgrow="ALWAYS" percentWidth="25.0" />
        </columnConstraints>

        <rowConstraints>
            <RowConstraints vgrow="ALWAYS" />
            <RowConstraints vgrow="ALWAYS" />
            <RowConstraints vgrow="ALWAYS" />
            <RowConstraints vgrow="ALWAYS" />
        </rowConstraints>

        <!-- ===== Row 1 (Labels) ===== -->
        <Label text="I/P Volt" GridPane.columnIndex="0" GridPane.rowIndex="0" />
        <Label text="O/P Volt" GridPane.columnIndex="1" GridPane.rowIndex="0" />
        <Label text="Temp" GridPane.columnIndex="2" GridPane.rowIndex="0" />
        <Label text="I/P Freq" GridPane.columnIndex="3" GridPane.rowIndex="0" />

        <!-- ===== Row 2 (Values) ===== -->
        <Label fx:id="txtInputVoltage" alignment="CENTER" GridPane.columnIndex="0" GridPane.rowIndex="1" />
        <Label fx:id="txtOutputVoltage" alignment="CENTER" GridPane.columnIndex="1" GridPane.rowIndex="1" />
        <Label fx:id="txtTemperature" alignment="CENTER" GridPane.columnIndex="2" GridPane.rowIndex="1" />
        <Label fx:id="txtInputFrequency" alignment="CENTER" GridPane.columnIndex="3" GridPane.rowIndex="1" />

        <!-- ===== Row 3 (Labels) ===== -->
        <Label text="O/P Current" GridPane.columnIndex="0" GridPane.rowIndex="2" />
        <Label text="I/P Fault Volt" GridPane.columnIndex="1" GridPane.rowIndex="2" />
        <Label text="Battery Volt" GridPane.columnIndex="2" GridPane.rowIndex="2" />

        <!-- ===== Row 4 (Values) ===== -->
        <Label fx:id="txtOutputCurrent" alignment="CENTER" GridPane.columnIndex="0" GridPane.rowIndex="3" />
        <Label fx:id="txtInputFaultVoltage" alignment="CENTER" GridPane.columnIndex="1" GridPane.rowIndex="3" />
        <Label fx:id="txtBatteryVoltage" alignment="CENTER" GridPane.columnIndex="2" GridPane.rowIndex="3" />
    </GridPane>


    <!-- ===================== UPS Status Section ===================== -->
    <Label style="-fx-font-size: 16px; -fx-font-weight: bold;" text="UPS Status Flags" />

    <GridPane alignment="CENTER" hgap="10" style="-fx-background-color: #ffffff; -fx-border-color: #cccccc; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 15;" vgap="8">
        <columnConstraints>
            <ColumnConstraints halignment="CENTER" hgrow="ALWAYS" percentWidth="25" />
            <ColumnConstraints halignment="CENTER" hgrow="ALWAYS" percentWidth="25" />
            <ColumnConstraints halignment="CENTER" hgrow="ALWAYS" percentWidth="25" />
            <ColumnConstraints halignment="CENTER" hgrow="ALWAYS" percentWidth="25" />
        </columnConstraints>

        <rowConstraints>
            <RowConstraints vgrow="ALWAYS" />
            <RowConstraints vgrow="ALWAYS" />
        </rowConstraints>

        <!-- Row 1 -->
        <Label fx:id="lblUtilityNormal" text="Utility Normal" GridPane.columnIndex="0" />
        <Label fx:id="lblBatteryNormal" text="Battery Normal" GridPane.columnIndex="1" />
        <Label fx:id="lblStandbyUPS" text="Standby UPS" GridPane.columnIndex="2" />
        <Label fx:id="lblTestProgress" text="Test not in Progress" GridPane.columnIndex="3" />

        <!-- Row 2 -->
        <Label fx:id="lblBypass" text="Bypass not Active" GridPane.columnIndex="0" GridPane.rowIndex="1" />
        <Label fx:id="lblUPSNormal" text="UPS Normal" GridPane.columnIndex="1" GridPane.rowIndex="1" />
        <Label fx:id="lblShutdown" text="Shutdown not Active" GridPane.columnIndex="2" GridPane.rowIndex="1" />
        <Label fx:id="lblBeeper" text="UPS Beeper Off" GridPane.columnIndex="3" GridPane.rowIndex="1" />
    </GridPane>

    <HBox alignment="CENTER" spacing="20" style="-fx-padding: 10;">
        <Button fx:id="btnRefresh"
                maxWidth="200"
                onAction="#onGetStatus"
                text="Refresh" />

        <Button fx:id="btnBack"
                maxWidth="200"
                onAction="#onBack"

                text="Back" />
    </HBox>




</VBox>
