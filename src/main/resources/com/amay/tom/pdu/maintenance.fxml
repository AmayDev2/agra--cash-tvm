<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.RowConstraints?>

<GridPane alignment="CENTER" prefWidth="640.0" styleClass="background" vgap="50.0" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.amay.tom.pdu.MaintenanceTestController">

    <!-- Columns -->
    <columnConstraints>
        <ColumnConstraints hgrow="ALWAYS" percentWidth="50.0" />
        <ColumnConstraints hgrow="ALWAYS" percentWidth="50.0" />
    </columnConstraints>

    <!-- Rows -->
    <rowConstraints>
        <RowConstraints percentHeight="25.0" valignment="CENTER" vgrow="ALWAYS" />
        <RowConstraints percentHeight="20.0" valignment="CENTER" vgrow="ALWAYS" />
        <RowConstraints percentHeight="20.0" valignment="CENTER" vgrow="ALWAYS" />
        <RowConstraints percentHeight="20.0" valignment="CENTER" vgrow="ALWAYS" />
        <RowConstraints percentHeight="20.0" valignment="CENTER" vgrow="ALWAYS" />
    </rowConstraints>

    <children>

        <!-- Row 0 -->
        <Button onAction="#onBNRTest" styleClass="navigatorButton" text="BNR Test" GridPane.halignment="CENTER" GridPane.hgrow="ALWAYS" GridPane.vgrow="ALWAYS">
         <GridPane.margin>
            <Insets left="20.0" right="20.0" top="10.0" />
         </GridPane.margin></Button>
        <Button onAction="#onCoinHopper" styleClass="navigatorButton" text="Coin Hopper" GridPane.columnIndex="1" GridPane.halignment="CENTER" GridPane.hgrow="ALWAYS" GridPane.vgrow="ALWAYS">
         <GridPane.margin>
            <Insets left="20.0" right="20.0" top="10.0" />
         </GridPane.margin></Button>

        <!-- Row 1 -->
        <Button onAction="#onPrinterTest" styleClass="navigatorButton" text="Printer Test" GridPane.halignment="CENTER" GridPane.hgrow="ALWAYS" GridPane.rowIndex="1" GridPane.vgrow="ALWAYS">
         <GridPane.margin>
            <Insets left="20.0" right="20.0" />
         </GridPane.margin></Button>
        <Button onAction="#onUPSTest" styleClass="navigatorButton" text="UPS Test" GridPane.columnIndex="1" GridPane.halignment="CENTER" GridPane.hgrow="ALWAYS" GridPane.rowIndex="1" GridPane.vgrow="ALWAYS">
         <GridPane.margin>
            <Insets left="20.0" right="20.0" />
         </GridPane.margin></Button>

        <!-- Row 2 -->
        <Button onAction="#onPIdTest" styleClass="navigatorButton" text="PID Test" GridPane.halignment="CENTER" GridPane.hgrow="ALWAYS" GridPane.rowIndex="2" GridPane.vgrow="ALWAYS">
         <GridPane.margin>
            <Insets left="20.0" right="20.0" />
         </GridPane.margin></Button>
        <Button onAction="#onFeigTest" styleClass="navigatorButton" text="Feig Test" GridPane.columnIndex="1" GridPane.halignment="CENTER" GridPane.hgrow="ALWAYS" GridPane.rowIndex="2" GridPane.vgrow="ALWAYS">
         <GridPane.margin>
            <Insets left="20.0" right="20.0" />
         </GridPane.margin></Button>

        <!-- Row 3 -->
        <Button onAction="#onCommstest" styleClass="navigatorButton" text="Communication Test" GridPane.halignment="CENTER" GridPane.hgrow="ALWAYS" GridPane.rowIndex="3" GridPane.vgrow="ALWAYS">
         <GridPane.margin>
            <Insets left="20.0" right="20.0" />
         </GridPane.margin></Button>
        <Button onAction="#onRestart" styleClass="navigatorButton" text="Restart/Shutdown" GridPane.columnIndex="1" GridPane.halignment="CENTER" GridPane.hgrow="ALWAYS" GridPane.rowIndex="3" GridPane.vgrow="ALWAYS">
         <GridPane.margin>
            <Insets left="20.0" right="20.0" />
         </GridPane.margin></Button>

        <!-- Row 4 -->
        <Button onAction="#onBack" styleClass="backButton" text="Back" GridPane.columnSpan="2" GridPane.halignment="CENTER" GridPane.hgrow="ALWAYS" GridPane.rowIndex="4" GridPane.vgrow="ALWAYS">
         <GridPane.margin>
            <Insets bottom="5.0" left="20.0" right="20.0" />
         </GridPane.margin></Button>
    </children>

    <padding>
        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
    </padding>

</GridPane>
