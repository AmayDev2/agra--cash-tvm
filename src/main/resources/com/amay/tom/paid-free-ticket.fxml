<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Line?>
<?import javafx.scene.text.*?>
<VBox fx:id="paidFreeTicketView" alignment="CENTER" prefHeight="400.0" spacing="20.0" style=" -fx-background-radius: 10;"
      xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.amay.tom.controller.PaidFreeTicket">
    <padding>
        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
    </padding>

    <Button fx:id="freeTicket" mnemonicParsing="false"
            style="-fx-pref-width: 200px; -fx-background-color: #422323; -fx-background-radius: 5; -fx-text-fill: white;"
            text="Free Ticket">
        <font>
            <Font size="24.0"/>
        </font>
    </Button>
    <RadioButton fx:id="unreadeable" text="Unreadable Ticket">
        <toggleGroup>
            <ToggleGroup fx:id="toggleGroup2"/>
        </toggleGroup>
        <font>
            <Font size="24.0"/>
        </font>
    </RadioButton>
    <Line endX="400.0" startX="100" stroke="BLACK" strokeDashArray="5" strokeWidth="2.0">
        <VBox.margin>
            <Insets bottom="20.0" top="10.0"/>
        </VBox.margin>
    </Line>
    <Button mnemonicParsing="false" style="-fx-pref-width: 200px; -fx-background-color: #422323;
         -fx-background-radius: 5; -fx-text-fill: white;" text="Paid Ticket">
        <font>
            <Font size="24.0"/>
        </font>
    </Button>

    <RadioButton fx:id="tailgating" text="Tail Gating" toggleGroup="$toggleGroup2">
        <font>
            <Font size="24.0"/>
        </font>
    </RadioButton>
    <RadioButton fx:id="ticketless" text="Ticket less Passenger " toggleGroup="$toggleGroup2">
        <font>
            <Font size="24.0"/>
        </font>
    </RadioButton>

    <Line endX="280.0" startX="100" stroke="#0c80080c" strokeDashArray="5">
        <VBox.margin>
            <Insets bottom="30.0" top="20.0"/>
        </VBox.margin>
    </Line>
    <Button fx:id="issueButton" alignment="BOTTOM_CENTER" contentDisplay="CENTER" mnemonicParsing="false"
            onAction="#onClickIssue"
            style="-fx-pref-width: 300px; -fx-font-size: 24px; -fx-min-height: 50px; -fx-background-color: #00812e; -fx-background-radius: 5; -fx-text-fill: white;"
            text="Issue Ticket" textAlignment="CENTER">
        <font>
            <Font size="24.0"/>
        </font>
    </Button>
</VBox>
