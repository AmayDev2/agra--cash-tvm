<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<StackPane fx:id="stackPane" prefHeight="834.0" prefWidth="1077.0" styleClass="stack-pane" stylesheets="@../../../../css/payment.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.amay.tom.controller.PaymentController">
    <children>
        <BorderPane fx:id="borderPane" prefHeight="834.0" prefWidth="1077.0" styleClass="border-pane">
            <left>
                <VBox prefWidth="200.0" spacing="5.0" styleClass="vbox" BorderPane.alignment="CENTER">
                    <children>
                        <GridPane alignment="CENTER" vgap="20.0">
                            <columnConstraints>
                                <ColumnConstraints halignment="CENTER" hgrow="ALWAYS" minWidth="10.0" />
                            </columnConstraints>
                            <rowConstraints>
                                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                            </rowConstraints>
                            <children>
                                <Button fx:id="cash" onAction="#Cash" styleClass="payment-button" text="Cash" />
                                <Button fx:id="card" onAction="#Card" styleClass="payment-button" text="Card" GridPane.rowIndex="1" />
                                <Button fx:id="upi" onAction="#UPI" styleClass="payment-button" text="UPI" GridPane.rowIndex="2" />
                                <Button onAction="#Other" styleClass="payment-button" text="NCMC" GridPane.rowIndex="3" fx:id="xyz" />
                            </children>
                        </GridPane>
                    </children>
                </VBox>
            </left>
            <top>
                <VBox BorderPane.alignment="CENTER" />
            </top>
            <center>
                <VBox fx:id="centerVBox" spacing="10.0" styleClass="vbox">
                    <VBox fx:id="centerVBox1" alignment="TOP_CENTER" prefHeight="561.0" prefWidth="897.0" spacing="20.0"
                          styleClass="vbox">
                        <Text styleClass="payment-header-text" text="Tickets Payment Summary"/>
                        <GridPane fx:id="ticketsGrid" alignment="TOP_CENTER" gridLinesVisible="true">
                            <columnConstraints>
                                <ColumnConstraints fx:id="originCol" prefWidth="150.0"/>
                                <ColumnConstraints fx:id="destinationCol" prefWidth="150.0"/>
                                <ColumnConstraints fx:id="ticketTypeCol" prefWidth="100.0"/>
                                <ColumnConstraints fx:id="quantCol" prefWidth="100.0"/>
                                <ColumnConstraints fx:id="amountCol" prefWidth="100.0"/>
                            </columnConstraints>
                            <rowConstraints>
                                <RowConstraints fx:id="header" prefHeight="30.0" vgrow="SOMETIMES"/>
                                <RowConstraints prefHeight="30.0" vgrow="SOMETIMES"/>
                            </rowConstraints>
                            <Text styleClass="grid-header-label" text="Origin"/>
                            <Text styleClass="grid-header-label" text="Destination" GridPane.columnIndex="1"/>
                            <Text styleClass="grid-header-label" text="Type" GridPane.columnIndex="2"/>
                            <Text styleClass="grid-header-label" text="Quantity" GridPane.columnIndex="3"/>
                            <Text styleClass="grid-header-label" text="Amount" GridPane.columnIndex="4"/>
                        </GridPane>
                    </VBox>
                    <VBox fx:id="centerVBox2" styleClass="vbox" VBox.vgrow="ALWAYS">
                        <GridPane fx:id="calculationGrid" alignment="CENTER" vgap="10.0">
                            <columnConstraints>
                                <ColumnConstraints halignment="LEFT"/>
                                <ColumnConstraints maxWidth="395.0" minWidth="345.0" prefWidth="375.0"/>
                                <ColumnConstraints halignment="CENTER" maxWidth="88.0" minWidth="11.0"
                                                   prefWidth="58.0"/>
                                <ColumnConstraints halignment="CENTER" maxWidth="239.0" minWidth="205.0"
                                                   prefWidth="217.0"/>
                            </columnConstraints>
                            <rowConstraints>
                                <RowConstraints fx:id="cashReceivedAmount"/>
                                <RowConstraints fx:id="showChangeAmount"/>
                                <RowConstraints/>
                            </rowConstraints>
                            <Text styleClass="grid-header-label" text="Cash Received :"/>
                            <Text styleClass="grid-header-label" text="Change :" GridPane.rowIndex="1"/>
                            <Text styleClass="rupee-symbol" text="₹" textAlignment="CENTER"
                                  GridPane.columnIndex="2"/>
                            <Text styleClass="rupee-symbol" text="₹" textAlignment="CENTER" GridPane.columnIndex="2"
                                  GridPane.rowIndex="1"/>
                            <Text fx:id="changeAmount" styleClass="grid-header-label" text="0"
                                  GridPane.columnIndex="3" GridPane.rowIndex="1"/>
                            <TextField fx:id="cashReceived" onAction="#onBalanceUpdate"
                                       onInputMethodTextChanged="#onAmountUpdate" styleClass="cash-input"
                                       GridPane.columnIndex="3"/>
                            <Button fx:id="payAmountButton" onAction="#onClickPay" prefHeight="48.0"
                                    styleClass="pay-button" text="Pay" GridPane.columnIndex="3"
                                    GridPane.rowIndex="2"/>
                            <Button fx:id="cancelButton" layoutX="603.0" layoutY="105.0" onAction="#onClickCancel"
                                    prefHeight="48.0" styleClass="cancel-button" text="Cencel"
                                    GridPane.rowIndex="2"/>
                        </GridPane>
                    </VBox>
                </VBox>
            </center>
        </BorderPane>
    </children>
</StackPane>
