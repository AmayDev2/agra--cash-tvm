<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="600" prefWidth="900" style="-fx-background-color: white;" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/17.0.12">

    <VBox alignment="CENTER" layoutX="0" layoutY="0" prefHeight="600" prefWidth="900" spacing="20">

        <!-- Success Icon -->
        <ImageView fitHeight="240.0" fitWidth="240.0" preserveRatio="true">
            <image>
                <!-- Replace with your checkmark icon -->
                <Image url="@../../../../icons/assets_tom/success.png" />
            </image>
        </ImageView>

        <!-- Success Label -->
        <Label style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: green;" text="Transaction Successful" />
    </VBox>

</AnchorPane>
