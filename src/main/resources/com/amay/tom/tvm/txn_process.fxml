<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="600" prefWidth="900" style="-fx-background-color: white;" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/17.0.12">

    <VBox alignment="CENTER" layoutX="0" layoutY="0" prefHeight="600" prefWidth="1200" spacing="20">

        <ImageView fitHeight="240.0" fitWidth="240.0" preserveRatio="true">
            <image>
                <Image url="@icons/process.png" />
            </image>
        </ImageView>

        <Label style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: black;" text="Please Wait" />
        <Label style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: black;" text="Transaction in process" />
    </VBox>

</AnchorPane>
