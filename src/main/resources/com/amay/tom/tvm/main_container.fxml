                           <!-- Right Column Buttons -->
                           <Button fx:id="ncmcButton" text="NCMC Topup"
                                   styleClass="button-purchase" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
                           <Button fx:id="balanceUpdateButton" text="Balance Update"
                                   styleClass="button-purchase" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
                           <Button fx:id="cardInquiryButton" text="Card Inquiry"
                                   styleClass="button-purchase" GridPane.columnIndex="2" GridPane.rowIndex="2"/>
                       </children>
                   </GridPane>

                   <!--                   <fx:include source="station_selection_view.fxml"/>-->
