                            <Font name="System Bold" size="40.0" />
                        </font>
                        <effect>
                            <ColorAdjust />
                        </effect>
                        <styleClass>
                            <String fx:value="text-bold" />
                            <String fx:value="text-primary" />
                        </styleClass>
                    </Label>
                    <AnchorPane fx:id="logoPane"
                                styleClass="logo-pane"
                                prefWidth="227.0" prefHeight="100.0"
