                     -fx-background-position: center;
                     -fx-background-size: 60% 60%;
                     -fx-opacity: 0.12;
                     -fx-pref-width: 100%;
                     -fx-pref-height: 100%;" />

                     <!-- Main Grid: left buttons | divider | right buttons -->
                     <GridPane fx:id="home" hgap="40" vgap="10" alignment="CENTER"
                               maxWidth="1024.0" minWidth="1024.0" prefWidth="1024.0"
                               maxHeight="618.0" minHeight="618.0" prefHeight="618.0"
                               style="-fx-padding: 30 60 30 60;">

                         <columnConstraints>
                             <ColumnConstraints percentWidth="45" halignment="CENTER"/>
                             <ColumnConstraints percentWidth="10" halignment="CENTER"/>
                             <ColumnConstraints percentWidth="45" halignment="CENTER"/>
                         </columnConstraints>

                         <rowConstraints>
                             <RowConstraints percentHeight="25" vgrow="SOMETIMES"/>
                             <RowConstraints percentHeight="25" vgrow="SOMETIMES"/>
                             <RowConstraints percentHeight="25" vgrow="SOMETIMES"/>
                         </rowConstraints>

                         <children>
                             <!-- LEFT column buttons -->
                             <Button fx:id="sjtButton" text="SINGLE JOURNEY"
