<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox alignment="CENTER"
      stylesheets="@css/structure.css"
      style="-fx-background-color: #ffffff;" xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.amay.tvm.controller.TicketSelectionController">

    <Label styleClass="heading-label" text="Select Destination Station" textAlignment="CENTER">
    </Label>

            <HBox alignment="CENTER"  spacing="10.0" VBox.vgrow="ALWAYS">
                <VBox alignment="CENTER">
                    <GridPane fx:id="stationGrid" alignment="CENTER" hgap="20" minWidth="0.0" vgap="20">
                        <padding>
                            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
                        </padding>
                        <VBox.margin>
                            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
                        </VBox.margin>
                    </GridPane>
                </VBox>
            </HBox>
            <Region VBox.vgrow="ALWAYS" />
            <HBox alignment="CENTER"  spacing="10.0" VBox.vgrow="ALWAYS">
                
                <Button onAction="#navigateToHomePage"
                        styleClass="nav-button"
                        text="Back" textAlignment="CENTER" GridPane.halignment="LEFT" GridPane.rowIndex="2" GridPane.valignment="BOTTOM">
                </Button>


                <Button contentDisplay="RIGHT" styleClass="nav-button" onAction="#confirmSelection"  text="Next" textAlignment="CENTER" GridPane.halignment="RIGHT" GridPane.rowIndex="2" GridPane.valignment="BOTTOM">

                    <GridPane.margin>
                        <Insets bottom="30.0" right="50.0" />
                    </GridPane.margin>
                </Button>


            </HBox>
</VBox>
