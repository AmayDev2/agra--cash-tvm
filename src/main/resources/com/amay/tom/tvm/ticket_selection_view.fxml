<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" style="-fx-background-color: #ffffff;" stylesheets="@css/structure.css, @css/styles.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.amay.tvm.controller.TicketSelectionController">

    <Label styleClass="heading-label" text="Select Destination Station" textAlignment="CENTER">
    </Label>

            <HBox alignment="CENTER" spacing="10.0" VBox.vgrow="ALWAYS">
                <VBox alignment="CENTER">
                    <GridPane fx:id="stationGrid" alignment="CENTER" hgap="20" minWidth="0.0" vgap="20">
                        <padding>
                            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                        </padding>
                        <VBox.margin>
                            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                        </VBox.margin>
                    </GridPane>
                </VBox>
            </HBox>
            <Region VBox.vgrow="ALWAYS" />
            <HBox alignment="CENTER" spacing="10.0" VBox.vgrow="ALWAYS">
                
                <Button onAction="#navigateToHomePage" styleClass="nav-button" text="Back" textAlignment="CENTER" GridPane.halignment="LEFT" GridPane.rowIndex="2" GridPane.valignment="BOTTOM">
                </Button>


                <Button contentDisplay="RIGHT" onAction="#confirmSelection" styleClass="nav-button" text="Next" textAlignment="CENTER" GridPane.halignment="RIGHT" GridPane.rowIndex="2" GridPane.valignment="BOTTOM">

                    <GridPane.margin>
                        <Insets bottom="30.0" right="50.0" />
                    </GridPane.margin>
                </Button>


            </HBox>
</VBox>
