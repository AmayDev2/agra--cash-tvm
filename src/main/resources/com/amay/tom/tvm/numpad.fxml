<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"

            prefWidth="300" prefHeight="400">

    <!-- Display at the top -->
    <top>
        <TextField fx:id="display"
                   editable="false"
                   alignment="CENTER_RIGHT"
                   prefHeight="60"
                   BorderPane.alignment="CENTER"/>
    </top>

    <!-- Number pad in center -->
    <center>
        <GridPane fx:id="numpad"
                  hgap="10" vgap="10"
                  alignment="CENTER"
                  style="-fx-padding: 20;">

            <!-- Row 0 -->
            <Button fx:id="btn7" text="7" GridPane.rowIndex="0" GridPane.columnIndex="0" prefWidth="60" prefHeight="60"/>
            <Button fx:id="btn8" text="8" GridPane.rowIndex="0" GridPane.columnIndex="1" prefWidth="60" prefHeight="60"/>
            <Button fx:id="btn9" text="9" GridPane.rowIndex="0" GridPane.columnIndex="2" prefWidth="60" prefHeight="60"/>

            <!-- Row 1 -->
            <Button fx:id="btn4" text="4" GridPane.rowIndex="1" GridPane.columnIndex="0" prefWidth="60" prefHeight="60"/>
            <Button fx:id="btn5" text="5" GridPane.rowIndex="1" GridPane.columnIndex="1" prefWidth="60" prefHeight="60"/>
            <Button fx:id="btn6" text="6" GridPane.rowIndex="1" GridPane.columnIndex="2" prefWidth="60" prefHeight="60"/>

            <!-- Row 2 -->
            <Button fx:id="btn1" text="1" GridPane.rowIndex="2" GridPane.columnIndex="0" prefWidth="60" prefHeight="60"/>
            <Button fx:id="btn2" text="2" GridPane.rowIndex="2" GridPane.columnIndex="1" prefWidth="60" prefHeight="60"/>
            <Button fx:id="btn3" text="3" GridPane.rowIndex="2" GridPane.columnIndex="2" prefWidth="60" prefHeight="60"/>

            <!-- Row 3 (0 spans across) -->
            <Button fx:id="btn0" text="0"
                    GridPane.rowIndex="3" GridPane.columnIndex="0" GridPane.columnSpan="3"
                    maxWidth="Infinity" prefHeight="60"/>
        </GridPane>
    </center>
</BorderPane>
