<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>

<HBox prefHeight="680.0" prefWidth="1024.0" spacing="20" style="-fx-background-color: #ffffff;" stylesheets="@css/styles.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.amay.tvm.controller.PaymentController">

    <!-- LEFT COLUMN: NumPad + Quantity + Actions -->
    <VBox fx:id="leftColumn" alignment="TOP_LEFT" prefWidth="420.0" spacing="10">
        <padding>
            <Insets bottom="10.0" left="60.0" right="40.0" top="40.0" />
        </padding>

        <!-- Quantity row: Label - Decrement - Display - Increment -->
        <HBox alignment="CENTER_LEFT" spacing="12">
<!--            <Label styleClass="details-tag" text="Quantity" GridPane.columnIndex="3" GridPane.rowIndex="0" style="-fx-font-size:14px; -fx-font-weight:bold;" />-->
            <Button fx:id="btnDecrement" maxHeight="65" maxWidth="65" minHeight="65" minWidth="65" onAction="#handleDecrement" prefHeight="65" prefWidth="65" style="-fx-font-size:18; -fx-background-radius:6; -fx-background-color:#6b6b6b; -fx-text-fill:white;" text="-" />
            <TextField fx:id="display" alignment="CENTER" editable="false" prefHeight="65" prefWidth="120" style="-fx-font-size:16; -fx-background-radius:6; -fx-border-radius:6; -fx-border-color: #cccccc;" />
            <Button fx:id="btnIncrement" maxHeight="65" maxWidth="65" minHeight="65" minWidth="65" onAction="#handleIncrement" prefHeight="65" prefWidth="65" style="-fx-font-size:18; -fx-background-radius:6; -fx-background-color:#6b6b6b; -fx-text-fill:white;" text="+" />
        </HBox>

        <HBox alignment="CENTER" maxHeight="260.0" maxWidth="200.0" minWidth="274.0" prefWidth="200.0" spacing="5">
            <Label fx:id="minTicketSize" minWidth="120.0" text="Min: 1" />
            <Pane maxWidth="70.0" minWidth="39.0" prefHeight="23.0" prefWidth="39.0" HBox.hgrow="ALWAYS" />
            <Label fx:id="maxTicketSize" text="Max: 10" />
        </HBox>



        <!-- Add Ticket & Confirm Buttons -->
        <HBox alignment="CENTER_LEFT" spacing="20">
<!--            <padding>-->
<!--&lt;!&ndash;                <Insets top="10.0" />&ndash;&gt;-->
<!--            </padding>-->
<!--            <Button fx:id="btnAddTicket" text="Add Ticket" onAction="#handleAddTicket"-->
<!--                    prefWidth="140" prefHeight="44"-->
<!--                    style="-fx-background-radius:8; -fx-background-color:#7f7f7f; -fx-text-fill:white; -fx-font-weight:bold;"/>-->
            <Button fx:id="btnConfirm" onAction="#confirmTicket" prefHeight="44" prefWidth="275.0" style="-fx-background-radius:8; -fx-background-color:#2eae4a; -fx-text-fill:white; -fx-font-weight:bold;" text="Confirm" />
        </HBox>

        <!-- Spacer -->
<!--        <Region prefHeight="8" VBox.vgrow="NEVER" />-->

        <!-- Numpad (visual style like the photo) -->
        <GridPane fx:id="numpad" alignment="TOP_LEFT" hgap="30" vgap="26">
            <!-- Row 0 -->
            <Button fx:id="btn1" onAction="#handleNumberClick" prefHeight="72" prefWidth="72" styleClass="numpad" text="1" GridPane.columnIndex="0" GridPane.rowIndex="0" />
            <Button fx:id="btn2" onAction="#handleNumberClick" prefHeight="72" prefWidth="72" styleClass="numpad" text="2" GridPane.columnIndex="1" GridPane.rowIndex="0" />
            <Button fx:id="btn3" onAction="#handleNumberClick" prefHeight="72" prefWidth="72" styleClass="numpad" text="3" GridPane.columnIndex="2" GridPane.rowIndex="0" />

            <!-- Row 1 -->
            <Button fx:id="btn4" onAction="#handleNumberClick" prefHeight="72" prefWidth="72" styleClass="numpad" text="4" GridPane.columnIndex="0" GridPane.rowIndex="1" />
            <Button fx:id="btn5" onAction="#handleNumberClick" prefHeight="72" prefWidth="72" styleClass="numpad" text="5" GridPane.columnIndex="1" GridPane.rowIndex="1" />
            <Button fx:id="btn6" onAction="#handleNumberClick" prefHeight="72" prefWidth="72" styleClass="numpad" text="6" GridPane.columnIndex="2" GridPane.rowIndex="1" />

            <!-- Row 2 -->
            <Button fx:id="btn7" onAction="#handleNumberClick" prefHeight="72" prefWidth="72" styleClass="numpad" text="7" GridPane.columnIndex="0" GridPane.rowIndex="2" />
            <Button fx:id="btn8" onAction="#handleNumberClick" prefHeight="72" prefWidth="72" styleClass="numpad" text="8" GridPane.columnIndex="1" GridPane.rowIndex="2" />
            <Button fx:id="btn9" onAction="#handleNumberClick" prefHeight="72" prefWidth="72" styleClass="numpad" text="9" GridPane.columnIndex="2" GridPane.rowIndex="2" />

            <!-- Row 3: 0 centered below -->
            <Pane prefHeight="72" prefWidth="72" GridPane.columnIndex="0" GridPane.rowIndex="3" />
            <Button fx:id="btn0" onAction="#handleNumberClick" prefHeight="72" prefWidth="72" styleClass="numpad" text="0" GridPane.columnIndex="1" GridPane.rowIndex="3" />
            <Button fx:id="bkspc" onAction="#handleDeleteClick" prefHeight="72" prefWidth="72" styleClass="clear" text="Clear" GridPane.columnIndex="2" GridPane.rowIndex="3" />
         <columnConstraints>
            <ColumnConstraints />
            <ColumnConstraints />
            <ColumnConstraints />
         </columnConstraints>
         <rowConstraints>
            <RowConstraints />
            <RowConstraints />
            <RowConstraints />
            <RowConstraints />
         </rowConstraints>
        </GridPane>
    </VBox>

    <!-- Vertical divider like the grey bar in the photo -->
    <VBox alignment="CENTER" prefWidth="20">
        <Rectangle arcHeight="6" arcWidth="6" fill="#bdbdbd" height="480" width="8" />
    </VBox>

    <!-- RIGHT COLUMN: Summary + Payment + Action Buttons -->
    <VBox fx:id="rightColumn" alignment="TOP_CENTER" prefWidth="560.0" spacing="18">
        <padding>
            <Insets bottom="40.0" left="40.0" right="60.0" top="40.0" />
        </padding>

        <!-- "Order Summary" heading -->
        <Label alignment="CENTER_LEFT" style="-fx-font-size:20px; -fx-font-weight:bold; -fx-alignment: CENTER_LEFT;" text="Order Summary" />

        <!-- Summary card with rounded background -->
        <StackPane prefHeight="150" prefWidth="480" style="-fx-padding:18;">
            <Region prefHeight="150" prefWidth="480" style="-fx-background-color: rgba(245, 228, 214, 0.95);                    -fx-background-radius:12;                    -fx-border-radius:12;" />

            <GridPane alignment="TOP_LEFT" hgap="10" maxWidth="440" vgap="10">
                <padding>
                    <Insets bottom="8.0" left="8.0" right="8.0" top="8.0" />
                </padding>

                <columnConstraints>
                    <ColumnConstraints percentWidth="30" />
                    <ColumnConstraints percentWidth="30" />
                    <ColumnConstraints percentWidth="20" />
                    <ColumnConstraints percentWidth="20" />
                </columnConstraints>

                <!-- Header Labels -->
                <Label style="-fx-font-size:12px; -fx-font-weight:bold;" styleClass="details-tag" text="Origin" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                <Label style="-fx-font-size:12px; -fx-font-weight:bold;" styleClass="details-tag" text="Destination" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                <Label style="-fx-font-size:12px; -fx-font-weight:bold;" styleClass="details-tag" text="Type" GridPane.columnIndex="2" GridPane.rowIndex="0" />
                <Label style="-fx-font-size:12px; -fx-font-weight:bold;" styleClass="details-tag" text="Quantity" GridPane.columnIndex="3" GridPane.rowIndex="0" />

                <!-- Values -->
                <Label fx:id="labelFrom" style="-fx-font-size:12px;" styleClass="details-value" text="Sahar Road" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                <Label fx:id="labelTo" style="-fx-font-size:12px;" styleClass="details-value" text="Dadar Metro" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                <Label fx:id="labelType" style="-fx-font-size:12px;" styleClass="details-value" text="SJT" GridPane.columnIndex="2" GridPane.rowIndex="1" />
                <Label fx:id="labelCount" style="-fx-font-size:12px;" styleClass="details-value" text="2" GridPane.columnIndex="3" GridPane.rowIndex="1" />

                <!-- Total Amount -->
                <Label style="-fx-font-size:12px; -fx-font-weight:bold;" styleClass="details-tag" text="Total Amount" GridPane.columnIndex="0" GridPane.columnSpan="3" GridPane.rowIndex="3" />
                <Label fx:id="labelFare" style="-fx-font-size:12px;" styleClass="details-value" text="₹ 40" GridPane.columnIndex="3" GridPane.rowIndex="3" />

                <rowConstraints>
                    <RowConstraints />
                    <RowConstraints />
                    <RowConstraints />
                    <RowConstraints />
                </rowConstraints>
            </GridPane>
        </StackPane>


        <!-- Payment selection header (large underline) -->
        <VBox alignment="CENTER_LEFT" prefWidth="520" spacing="6">
            <Label style="-fx-font-size:24; -fx-font-weight:bold; -fx-underline:true;" text="SELECT PAYMENT METHOD" />
            <Separator prefWidth="520" />
        </VBox>

        <!-- Payment buttons -->
        <HBox alignment="CENTER" spacing="28">
            <ToggleButton fx:id="onClickCash" onAction="#handleCash" prefHeight="60.0" prefWidth="150" styleClass="pay-method" text="CASH" />
            <ToggleButton fx:id="onClickUPI" onAction="#handleUPI" prefHeight="60.0" prefWidth="150" styleClass="pay-method" text="UPI" />
            <ToggleButton fx:id="onClickCard" onAction="#handleCard" prefHeight="60.0" prefWidth="150" styleClass="pay-method" text="CARD" />
        </HBox>

        <!-- Spacer to push bottom buttons -->
        <Region VBox.vgrow="ALWAYS" />

        <!-- Bottom action buttons: Back (left) and Pay (right) -->
        <HBox alignment="CENTER" prefWidth="520" spacing="40">
            <Button fx:id="btnBack" onAction="#navigateToHomePage" prefHeight="52" prefWidth="140" styleClass="back" text="Back" />
            <Region HBox.hgrow="ALWAYS" />
            <Button fx:id="btnSubmit" onAction="#confirmSelection" prefHeight="52" prefWidth="140" styleClass="pay" text="Pay" />
        </HBox>
    </VBox>
</HBox>
