<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<HBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.amay.tvm.controller.PaymentController"
      prefHeight="600.0" prefWidth="1024.0"
      spacing="20" style="-fx-background-color: #ffffff;"
      stylesheets="@css/styles.css">

    <!-- LEFT: NumPad -->
    <VBox alignment="CENTER" spacing="10" prefWidth="400">
        <TextField fx:id="display" editable="false" alignment="CENTER_RIGHT"
                   prefHeight="60" prefWidth="300"/>
        <GridPane fx:id="numpad" hgap="10" vgap="10" alignment="CENTER"
                  style="-fx-padding: 20;">
            <!-- Row 0 -->
            <Button fx:id="btn7" text="7" GridPane.rowIndex="0" GridPane.columnIndex="0" prefWidth="60" prefHeight="60" onAction="#handleNumberClick"/>
            <Button fx:id="btn8" text="8" GridPane.rowIndex="0" GridPane.columnIndex="1" prefWidth="60" prefHeight="60" onAction="#handleNumberClick"/>
            <Button fx:id="btn9" text="9" GridPane.rowIndex="0" GridPane.columnIndex="2" prefWidth="60" prefHeight="60" onAction="#handleNumberClick"/>
            <!-- Row 1 -->
            <Button fx:id="btn4" text="4" GridPane.rowIndex="1" GridPane.columnIndex="0" prefWidth="60" prefHeight="60" onAction="#handleNumberClick"/>
            <Button fx:id="btn5" text="5" GridPane.rowIndex="1" GridPane.columnIndex="1" prefWidth="60" prefHeight="60" onAction="#handleNumberClick"/>
            <Button fx:id="btn6" text="6" GridPane.rowIndex="1" GridPane.columnIndex="2" prefWidth="60" prefHeight="60" onAction="#handleNumberClick"/>
            <!-- Row 2 -->
            <Button fx:id="btn1" text="1" GridPane.rowIndex="2" GridPane.columnIndex="0" prefWidth="60" prefHeight="60" onAction="#handleNumberClick"/>
            <Button fx:id="btn2" text="2" GridPane.rowIndex="2" GridPane.columnIndex="1" prefWidth="60" prefHeight="60" onAction="#handleNumberClick"/>
            <Button fx:id="btn3" text="3" GridPane.rowIndex="2" GridPane.columnIndex="2" prefWidth="60" prefHeight="60" onAction="#handleNumberClick"/>
            <!-- Row 3 -->
            <Button fx:id="btn0" text="0" GridPane.rowIndex="3" GridPane.columnIndex="0"
                    GridPane.columnSpan="3" maxWidth="Infinity" prefHeight="60" onAction="#handleNumberClick"/>
            <Button fx:id="bkspc" text="Back" GridPane.rowIndex="3" GridPane.columnIndex="1"
                    GridPane.columnSpan="3" maxWidth="Infinity" prefHeight="60" onAction="#handleDeleteClick"/>
        </GridPane>
    </VBox>

    <!-- RIGHT: Existing Content -->
    <VBox alignment="CENTER" spacing="20" prefWidth="624">

        <!-- Payment Method Section -->
        <VBox alignment="CENTER" spacing="10">
            <Label styleClass="heading-label" text="Select Payment Method" textAlignment="CENTER" />
            <HBox alignment="CENTER" spacing="30">
                <ToggleButton fx:id="onClickCard" onAction="#handleCard" prefHeight="120.0" prefWidth="200" styleClass="button-payment-select" text="Card">
                    <graphic>
                        <ImageView fitHeight="70.0" fitWidth="70.0">
                            <image>
                                <Image url="@../../../../images/tvm/card.png" />
                            </image>
                        </ImageView>
                    </graphic>
                </ToggleButton>
                <ToggleButton fx:id="onClickCash" onAction="#handleCash" prefHeight="120.0" prefWidth="200" styleClass="button-payment-select" text="CASH">
                    <graphic>
                        <ImageView fitHeight="70.0" fitWidth="70.0">
                            <image>
                                <Image url="@../../../../images/tvm/cash.png" />
                            </image>
                        </ImageView>
                    </graphic>
                </ToggleButton>
                <ToggleButton fx:id="onClickUPI" onAction="#handleUPI" prefHeight="120.0" prefWidth="200" styleClass="button-payment-select" text="UPI">
                    <graphic>
                        <ImageView fitHeight="70.0" fitWidth="70.0">
                            <image>
                                <Image url="@../../../../images/tvm/upi.png" />
                            </image>
                        </ImageView>
                    </graphic>
                </ToggleButton>
            </HBox>
        </VBox>

        <!-- Ticket Summary Section -->
        <GridPane fx:id="ticketSummary" alignment="CENTER" hgap="20" vgap="5.0"
                  minHeight="300.0" minWidth="600.0" prefHeight="300.0" prefWidth="600.0">
            <columnConstraints>
                <ColumnConstraints percentWidth="30.0" />
                <ColumnConstraints halignment="LEFT" percentWidth="30.0" />
                <ColumnConstraints halignment="CENTER" percentWidth="10.0" />
                <ColumnConstraints halignment="LEFT" percentWidth="30.0" />
                <ColumnConstraints percentWidth="30.0" />
            </columnConstraints>
            <rowConstraints>
                <RowConstraints percentHeight="20.0" />
                <RowConstraints percentHeight="20.0" />
                <RowConstraints percentHeight="20.0" />
                <RowConstraints percentHeight="20.0" />
                <RowConstraints percentHeight="20.0" />
            </rowConstraints>

            <Label styleClass="details-tag" text="From" GridPane.columnIndex="1" GridPane.rowIndex="0" />
            <Label fx:id="labelFrom" styleClass="details-value" text="Station 1" GridPane.columnIndex="3" GridPane.rowIndex="0" />

            <Label styleClass="details-tag" text="To" GridPane.columnIndex="1" GridPane.rowIndex="1" />
            <Label fx:id="labelTo" styleClass="details-value" text="Station 10" GridPane.columnIndex="3" GridPane.rowIndex="1" />

            <Label styleClass="details-tag" text="Ticket Type" GridPane.columnIndex="1" GridPane.rowIndex="2" />
            <Label fx:id="labelType" styleClass="details-value" text="Return Journey" GridPane.columnIndex="3" GridPane.rowIndex="2" />

            <Label styleClass="details-tag" text="Tickets Count" GridPane.columnIndex="1" GridPane.rowIndex="3" />
            <Label fx:id="labelCount" styleClass="details-value" text="2" GridPane.columnIndex="3" GridPane.rowIndex="3" />

            <Label styleClass="details-tag" text="Total Fare" GridPane.columnIndex="1" GridPane.rowIndex="4" />
            <Label fx:id="labelFare" styleClass="details-value" text="₹ 120" GridPane.columnIndex="3" GridPane.rowIndex="4" />
            <Label styleClass="details-tag" text=":" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
            <Label styleClass="details-tag" text=":" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
            <Label styleClass="details-tag" text=":" GridPane.columnIndex="2" GridPane.rowIndex="2"/>
            <Label styleClass="details-tag" text=":" GridPane.columnIndex="2" GridPane.rowIndex="3"/>
            <Label styleClass="details-tag" text=":" GridPane.columnIndex="2" GridPane.rowIndex="4"/>
        </GridPane>

        <!-- Proceed Buttons -->
        <HBox alignment="CENTER" spacing="10.0" minHeight="60.0" prefHeight="60.0" prefWidth="600.0">
            <Button fx:id="btnBack" alignment="CENTER" minHeight="60.0" onAction="#navigateToHomePage"
                    prefHeight="60.0" prefWidth="250.0" styleClass="button-nav" text="Back" textAlignment="CENTER">
                <graphic>
                    <ImageView fitHeight="50.0" fitWidth="50.0" rotate="180.0" translateX="-50.0">
                        <image>
                            <Image url="@../../../../images/tvm/arrow-circle.png" />
                        </image>
                    </ImageView>
                </graphic>
            </Button>
            <Button fx:id="btnSubmit" contentDisplay="RIGHT" minHeight="60.0" onAction="#confirmSelection"
                    prefHeight="60.0" prefWidth="250.0" styleClass="button-nav" text="Process" textAlignment="CENTER">
                <graphic>
                    <ImageView fitHeight="50.0" fitWidth="50.0" translateX="15.0">
                        <image>
                            <Image url="@../../../../images/tvm/arrow-circle.png" />
                        </image>
                    </ImageView>
                </graphic>
            </Button>
        </HBox>
    </VBox>
</HBox>
