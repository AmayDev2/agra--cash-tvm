<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="TOP_CENTER" spacing="40.0" style="-fx-background-color: #fff;" stylesheets="@css/structure.css" VBox.vgrow="ALWAYS" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.amay.tvm.controller.SessionCompletion">
    <!-- Title -->
    <Label fx:id="eventTitle" alignment="CENTER" styleClass="heading-label" text="Transaction Successful" />

    <!-- Success image -->
    <ImageView fx:id="event" fitHeight="300.0" pickOnBounds="true" preserveRatio="true">
        <Image url="@../../../../icons/assets_tom/success.png" />
    </ImageView>



    <!-- Message -->
    <Label fx:id="msgDisp" alignment="CENTER" styleClass="msg-label" text="" />

<!--    <Region VBox.vgrow="ALWAYS" />-->

    <!-- Back button -->
    <Button fx:id="skipPrintBtn" onAction="#skipPrintReceipt" styleClass="nav-button" text="Back" textFill="WHITE" />
</VBox>
