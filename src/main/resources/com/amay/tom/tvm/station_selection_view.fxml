<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox prefHeight="518.0" prefWidth="1024.0" style="-fx-background-color: #ffffff;" stylesheets="@css/styles.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.amay.tvm.controller.StationSelectionController">

    <StackPane alignment="CENTER" minHeight="458.0" prefHeight="458.0" VBox.vgrow="ALWAYS">
        <children>

            <GridPane alignment="CENTER" hgap="10.0" minHeight="458.0" minWidth="1024.0" prefHeight="458.0" prefWidth="1024.0" vgap="10.0">
                <columnConstraints>
                    <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                </columnConstraints>
                <rowConstraints>
                    <RowConstraints percentHeight="25.0" vgrow="SOMETIMES" />
                    <RowConstraints percentHeight="25.0" vgrow="SOMETIMES" />
                    <RowConstraints percentHeight="25.0" vgrow="SOMETIMES" />
                    <RowConstraints percentHeight="25.0" vgrow="SOMETIMES" />
                    <RowConstraints percentHeight="25.0" vgrow="SOMETIMES" />
                </rowConstraints>
                <children>
                    <!-- Changed to ToggleButton -->
                    <ToggleButton fx:id="journey_01" onAction="#selectJourney" styleClass="button-journey" text="Single Journey" GridPane.halignment="LEFT" GridPane.rowIndex="1">
                        <GridPane.margin>
                            <Insets left="100.0" />
                        </GridPane.margin>
                    </ToggleButton>

                    <!-- Changed to ToggleButton -->
                    <ToggleButton fx:id="journey_02" onAction="#selectJourney" styleClass="button-journey" text="Return Journey" GridPane.halignment="RIGHT" GridPane.rowIndex="1">
                        <GridPane.margin>
                            <Insets right="100.0" />
                        </GridPane.margin>
                    </ToggleButton>

                    <GridPane GridPane.rowIndex="3">
                        <columnConstraints>
                            <ColumnConstraints halignment="CENTER" hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                            <ColumnConstraints halignment="CENTER" hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                            <ColumnConstraints halignment="CENTER" hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                            <ColumnConstraints halignment="CENTER" hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                            <ColumnConstraints halignment="CENTER" hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                            <ColumnConstraints halignment="CENTER" hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                        </columnConstraints>
                        <rowConstraints>
                            <RowConstraints vgrow="SOMETIMES" />
                        </rowConstraints>
                        <children>
                            <!-- Changed all to ToggleButton -->
                            <ToggleButton fx:id="pass_1" onAction="#selectPass" styleClass="button-passenger" text="1" />
                            <ToggleButton fx:id="pass_2" onAction="#selectPass" styleClass="button-passenger" text="2" GridPane.columnIndex="1" />
                            <ToggleButton fx:id="pass_3" onAction="#selectPass" styleClass="button-passenger" text="3" GridPane.columnIndex="2" />
                            <ToggleButton fx:id="pass_4" onAction="#selectPass" styleClass="button-passenger" text="4" GridPane.columnIndex="3" />
                            <ToggleButton fx:id="pass_5" onAction="#selectPass" styleClass="button-passenger" text="5" GridPane.columnIndex="4" />
                            <ToggleButton fx:id="pass_6" alignment="CENTER" onAction="#selectPass" styleClass="button-passenger" text="6" textAlignment="CENTER" GridPane.columnIndex="5" />
                        </children>
                        <padding>
                            <Insets left="100.0" right="100.0" />
                        </padding>
                    </GridPane>

                    <Label styleClass="info-label" text="Select Passenger Count" GridPane.halignment="CENTER" GridPane.rowIndex="2" />
                    <Label fx:id="calculatedFare" styleClass="info-label" text="Total Fare : ₹ 0" GridPane.halignment="CENTER" GridPane.rowIndex="4" />
                    <Label fx:id="destination" alignment="CENTER" styleClass="info-label-station" text="Station Name" textAlignment="CENTER" GridPane.halignment="CENTER">
                        <font>
                            <Font size="30.0" />
                        </font>
                    </Label>
                </children>
            </GridPane>
        </children>
    </StackPane>

    <HBox alignment="CENTER" minHeight="50.0" minWidth="1024.0" prefHeight="50.0" prefWidth="1024.0" spacing="10.0" VBox.vgrow="ALWAYS">
        <Button fx:id="btnBack" minHeight="60.0" onAction="#navigateToHomePage" prefHeight="60.0" prefWidth="250.0" styleClass="button-nav" text="Back" textAlignment="CENTER">
            <graphic>
                <ImageView fx:id="iconView" fitHeight="50.0" fitWidth="50.0" rotate="180.0" translateX="-50.0">
                    <image>
                        <Image url="@../../../../images/tvm/arrow-circle.png" />
                    </image>
                </ImageView>
            </graphic>
            <GridPane.margin>
                <Insets bottom="30.0" left="50.0" />
            </GridPane.margin>
        </Button>

        <Button fx:id="btnSubmit" contentDisplay="RIGHT" minHeight="60.0" onAction="#confirmSelection" prefHeight="60.0" prefWidth="250.0" styleClass="button-nav" text="Continue" textAlignment="CENTER">
            <graphic>
                <ImageView fx:id="iconView1" fitHeight="50.0" fitWidth="50.0" translateX="15.0">
                    <image>
                        <Image url="@../../../../images/tvm/arrow-circle.png" />
                    </image>
                </ImageView>
            </graphic>
            <GridPane.margin>
                <Insets bottom="30.0" right="50.0" />
            </GridPane.margin>
        </Button>
    </HBox>

</VBox>
