<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<GridPane style="-fx-background-color: #ffffff;" stylesheets="@css/styles.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.amay.tvm.controller.SpecialModeController">

    <columnConstraints>
        <ColumnConstraints halignment="CENTER" hgrow="SOMETIMES" />
    </columnConstraints>
    <rowConstraints>
        <RowConstraints fillHeight="false" valignment="TOP" vgrow="SOMETIMES" />
        <RowConstraints vgrow="SOMETIMES" />
        <RowConstraints vgrow="SOMETIMES" />
    </rowConstraints>

    <!-- Emergency Mode Label -->
    <Label fx:id="label" styleClass="emergency-label" text="⚠ EMERGENCY MODE ACTIVATED ⚠" GridPane.columnIndex="0" GridPane.halignment="CENTER" GridPane.rowIndex="0" GridPane.valignment="CENTER" />

    <Label fx:id="messageLabel" styleClass="message_label" text="Please leave the Station Immediately" GridPane.columnIndex="0" GridPane.halignment="CENTER" GridPane.rowIndex="2" GridPane.valignment="CENTER" />
    <ImageView fx:id="imageView" fitWidth="450.0" pickOnBounds="true" preserveRatio="true" GridPane.rowIndex="1">
        <Image url="@/images/emergency.png" />
    </ImageView>

</GridPane>
