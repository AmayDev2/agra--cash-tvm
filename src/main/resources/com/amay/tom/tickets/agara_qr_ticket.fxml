<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox fx:id="ticketRoot" alignment="TOP_CENTER" rotate="90" style="-fx-background-color: white; -fx-padding: 10;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.amay.tom.controller.AgaraTicketController">

    <!-- Header -->
    <HBox alignment="CENTER" spacing="5.0">
        <ImageView fx:id="logoImage" fitHeight="30.0" preserveRatio="true">
            <Image url="@../../../../images/indoor-bhopal-logo-ticket.png" />
        </ImageView>
        <Text fx:id="ticketName" style="-fx-font-size: 40px; -fx-font-weight: bold;" text="Indore Metro" />
      <VBox.margin>
         <Insets top="18.0" bottom="2" />
      </VBox.margin>
    </HBox>

    <!-- QR Code -->
    <ImageView fx:id="qrImage" fitHeight="150.0" fitWidth="150.0">
      <VBox.margin>
         <Insets />
      </VBox.margin></ImageView>

    <!-- Ticket Details -->
    <GridPane alignment="TOP_CENTER" hgap="10">
        <columnConstraints>
            <ColumnConstraints />
            <ColumnConstraints halignment="LEFT" />
            <ColumnConstraints halignment="CENTER" maxWidth="10" minWidth="5" />
            <ColumnConstraints halignment="LEFT" />
        </columnConstraints>

        <Text text="Date/Time" GridPane.columnIndex="1" GridPane.rowIndex="0" />
        <Text text=":" GridPane.columnIndex="2" GridPane.rowIndex="0" />
        <Text fx:id="dateTimeText" text="13-05-2025 07:57:40 PM" GridPane.columnIndex="3" GridPane.rowIndex="0" />

        <Text text="Payment Type" GridPane.columnIndex="1" GridPane.rowIndex="1" />
        <Text text=":" GridPane.columnIndex="2" GridPane.rowIndex="1" />
        <Text fx:id="paymentTypeText" text="UPI" GridPane.columnIndex="3" GridPane.rowIndex="1" />

        <Text text="Salepoint Id" GridPane.columnIndex="1" GridPane.rowIndex="2" />
        <Text text=":" GridPane.columnIndex="2" GridPane.rowIndex="2" />
        <Text fx:id="salepointText" text="TOM-02" GridPane.columnIndex="3" GridPane.rowIndex="2" />

        <Text text="Type" GridPane.columnIndex="1" GridPane.rowIndex="3" />
        <Text text=":" GridPane.columnIndex="2" GridPane.rowIndex="3" />
        <Text fx:id="ticketTypeText" text="SJT" GridPane.columnIndex="3" GridPane.rowIndex="3" />

        <Text text="Quantity" GridPane.columnIndex="1" GridPane.rowIndex="4" />
        <Text text=":" GridPane.columnIndex="2" GridPane.rowIndex="4" />
        <Text fx:id="quantityText" text="1" GridPane.columnIndex="3" GridPane.rowIndex="4" />

        <Text text="From" GridPane.columnIndex="1" GridPane.rowIndex="5" />
        <Text text=":" GridPane.columnIndex="2" GridPane.rowIndex="5" />
        <Text fx:id="fromText" text="Captain Shubham Gupta" GridPane.columnIndex="3" GridPane.rowIndex="5" />

        <Text text="To" GridPane.columnIndex="1" GridPane.rowIndex="6" />
        <Text text=":" GridPane.columnIndex="2" GridPane.rowIndex="6" />
        <Text fx:id="toText" text="Fatehabad Road" GridPane.columnIndex="3" GridPane.rowIndex="6" />

        <Text text="Price" GridPane.columnIndex="1" GridPane.rowIndex="7" />
        <Text text=":" GridPane.columnIndex="2" GridPane.rowIndex="7" />
        <Text fx:id="priceText" text="Rs. 10.00" GridPane.columnIndex="3" GridPane.rowIndex="7" />

        <Text text="Ticket No" GridPane.columnIndex="1" GridPane.rowIndex="8" />
        <Text text=":" GridPane.columnIndex="2" GridPane.rowIndex="8" />
        <Text fx:id="ticketNumberText" text="9264.2.8.40" GridPane.columnIndex="3" GridPane.rowIndex="8" />

        <Text text="Valid Upto" GridPane.columnIndex="1" GridPane.rowIndex="9" />
        <Text text=":" GridPane.columnIndex="2" GridPane.rowIndex="9" />
        <Text fx:id="validUptoText" text="120 minutes after entry" GridPane.columnIndex="3" GridPane.rowIndex="9" />
      <rowConstraints>
         <RowConstraints />
         <RowConstraints />
         <RowConstraints />
         <RowConstraints />
         <RowConstraints />
         <RowConstraints />
         <RowConstraints />
         <RowConstraints />
         <RowConstraints />
         <RowConstraints />
      </rowConstraints>
    </GridPane>

    <!-- Footer -->
<!--    <Text text="Valid only for same working day"/>-->
    <HBox alignment="TOP_CENTER">
    <Text text="Valid only for same working day">
    </Text>
      <padding>
         <Insets bottom="15.0"  />
      </padding>
    </HBox>
</VBox>
