<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.amay.tom.controller.TestToolController"
            style="-fx-background-color: #f5f5f5;">

    <fx:define>
        <ToggleGroup fx:id="tg_shutter"/>
        <ToggleGroup fx:id="tg_register"/>
        <ToggleGroup fx:id="tg_rs1"/>
        <ToggleGroup fx:id="tg_rs2"/>
        <ToggleGroup fx:id="tg_rs5"/>
        <ToggleGroup fx:id="tg_rs10"/>
        <ToggleGroup fx:id="tg_rs20"/>
    </fx:define>

    <top>
        <VBox spacing="10" style="-fx-background-color: #2c3e50; -fx-padding: 15;">
<!--            <Label text="TVM Test Tool" textFill="white"-->
<!--                   style="-fx-font-size: 18px; -fx-font-weight: bold;"/>-->
            <HBox spacing="10" alignment="CENTER_LEFT">
                <ComboBox fx:id="top_portCombo" prefWidth="120"
                          style="-fx-background-radius: 4;"/>
                <Button fx:id="top_openPortBtn" text="Open Port"
                        style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-background-radius: 4;"/>
                <Button fx:id="top_closePortBtn" text="Close Port"
                        style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-background-radius: 4;"/>
                <Button fx:id="top_pollingStatusBtn" text="Polling Status"
                        style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-background-radius: 4;"/>
                <Button fx:id="top_getVersionBtn" text="Get Version"
                        style="-fx-background-color: #9b59b6; -fx-text-fill: white; -fx-background-radius: 4;"/>
                <Button fx:id="top_clearDisplayInfoBtn" text="Clear Display"
                        style="-fx-background-color: #f39c12; -fx-text-fill: white; -fx-background-radius: 4;"/>
                <Button fx:id="top_okBtn" text="OK"
                        style="-fx-background-color: #34495e; -fx-text-fill: white; -fx-background-radius: 4;"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <VBox spacing="10" style="-fx-padding: 10;">
            <!-- Main Controls Row -->
            <HBox spacing="10" VBox.vgrow="ALWAYS">
                <!-- Left Column: Module Test & Box ID -->
                <VBox spacing="10" prefWidth="200" HBox.hgrow="ALWAYS">
                    <!-- Module Test -->
                    <VBox spacing="8" style="-fx-background-color: white; -fx-border-color: #bdc3c7; -fx-border-radius: 6; -fx-padding: 10;" VBox.vgrow="ALWAYS">
                        <Label text="Module Test" style="-fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                        <ComboBox fx:id="module_dejammingMotorCombo" prefWidth="180"/>
                        <Button fx:id="module_moduleTestBtn" text="Run Test"
                                style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-background-radius: 4;"/>
                    </VBox>

                    <!-- Box ID -->
                    <VBox spacing="8" style="-fx-background-color: white; -fx-border-color: #bdc3c7; -fx-border-radius: 6; -fx-padding: 10;" VBox.vgrow="ALWAYS">
                        <Label text="Box ID Management" style="-fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                        <Button fx:id="box_setBoxIdBtn" text="Set Box ID"
                                style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-background-radius: 4;"/>
                        <Button fx:id="box_getCollectionBoxIdBtn" text="Get Box ID"
                                style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-background-radius: 4;"/>
                        <TextField fx:id="box_boxIdField" prefWidth="120" promptText="Enter Box ID"
                                   style="-fx-background-radius: 4;"/>
                    </VBox>
                </VBox>

                <!-- Middle Column: Coin Controls -->
                <VBox spacing="8" style="-fx-background-color: white; -fx-border-color: #bdc3c7; -fx-border-radius: 6; -fx-padding: 10; -fx-pref-width: 280;" HBox.hgrow="ALWAYS">
                    <Label text="Coin Controls" style="-fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>

                    <GridPane hgap="10" vgap="8">
                        <columnConstraints>
                            <ColumnConstraints prefWidth="100"/>
                            <ColumnConstraints prefWidth="150"/>
                        </columnConstraints>
                        <children>
                            <!-- Coin Shutter -->
                            <Label text="Coin Shutter:" GridPane.rowIndex="0" GridPane.columnIndex="0" style="-fx-font-size: 11px; -fx-text-fill: #7f8c8d;"/>
                            <HBox spacing="8" GridPane.rowIndex="0" GridPane.columnIndex="1">
                                <RadioButton fx:id="shutter_closeRb" text="Close" toggleGroup="$tg_shutter"/>
                                <RadioButton fx:id="shutter_openRb" text="Open" toggleGroup="$tg_shutter"/>
                            </HBox>

                            <!-- Coin Register -->
                            <Label text="Coin Register:" GridPane.rowIndex="1" GridPane.columnIndex="0" style="-fx-font-size: 11px; -fx-text-fill: #7f8c8d;"/>
                            <HBox spacing="8" GridPane.rowIndex="1" GridPane.columnIndex="1">
                                <RadioButton fx:id="reg_notClearRb" text="Not Clear" toggleGroup="$tg_register"/>
                                <RadioButton fx:id="reg_clearRb" text="Clear" toggleGroup="$tg_register"/>
                            </HBox>

                            <!-- Denominations -->
                            <Label text="Rs 1:" GridPane.rowIndex="2" GridPane.columnIndex="0" style="-fx-font-size: 11px; -fx-text-fill: #7f8c8d;"/>
                            <HBox spacing="8" GridPane.rowIndex="2" GridPane.columnIndex="1">
                                <RadioButton fx:id="rs1_activateRb" text="Activate" toggleGroup="$tg_rs1"/>
                                <RadioButton fx:id="rs1_inhibitRb" text="Inhibit" toggleGroup="$tg_rs1"/>
                            </HBox>

                            <Label text="Rs 2:" GridPane.rowIndex="3" GridPane.columnIndex="0" style="-fx-font-size: 11px; -fx-text-fill: #7f8c8d;"/>
                            <HBox spacing="8" GridPane.rowIndex="3" GridPane.columnIndex="1">
                                <RadioButton fx:id="rs2_activateRb" text="Activate" toggleGroup="$tg_rs2"/>
                                <RadioButton fx:id="rs2_inhibitRb" text="Inhibit" toggleGroup="$tg_rs2"/>
                            </HBox>

                            <Label text="Rs 5:" GridPane.rowIndex="4" GridPane.columnIndex="0" style="-fx-font-size: 11px; -fx-text-fill: #7f8c8d;"/>
                            <HBox spacing="8" GridPane.rowIndex="4" GridPane.columnIndex="1">
                                <RadioButton fx:id="rs5_activateRb" text="Activate" toggleGroup="$tg_rs5"/>
                                <RadioButton fx:id="rs5_inhibitRb" text="Inhibit" toggleGroup="$tg_rs5"/>
                            </HBox>

                            <Label text="Rs 10:" GridPane.rowIndex="5" GridPane.columnIndex="0" style="-fx-font-size: 11px; -fx-text-fill: #7f8c8d;"/>
                            <HBox spacing="8" GridPane.rowIndex="5" GridPane.columnIndex="1">
                                <RadioButton fx:id="rs10_activateRb" text="Activate" toggleGroup="$tg_rs10"/>
                                <RadioButton fx:id="rs10_inhibitRb" text="Inhibit" toggleGroup="$tg_rs10"/>
                            </HBox>

                            <Label text="Rs 20:" GridPane.rowIndex="6" GridPane.columnIndex="0" style="-fx-font-size: 11px; -fx-text-fill: #7f8c8d;"/>
                            <HBox spacing="8" GridPane.rowIndex="6" GridPane.columnIndex="1">
                                <RadioButton fx:id="rs20_activateRb" text="Activate" toggleGroup="$tg_rs20"/>
                                <RadioButton fx:id="rs20_inhibitRb" text="Inhibit" toggleGroup="$tg_rs20"/>
                            </HBox>
                        </children>
                    </GridPane>

                    <Button fx:id="coin_acceptPollingBtn" text="Manual Coin Polling"
                            style="-fx-background-color: #f39c12; -fx-text-fill: white; -fx-background-radius: 4;"/>
                </VBox>

                <!-- Right Column: Status & Quick Actions -->
                <VBox spacing="10" prefWidth="220" HBox.hgrow="ALWAYS">
                    <!-- System Status -->
                    <VBox spacing="6" style="-fx-background-color: white; -fx-border-color: #bdc3c7; -fx-border-radius: 6; -fx-padding: 10;" VBox.vgrow="ALWAYS">
                        <Label text="System Status" style="-fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                        <VBox spacing="3">
                            <HBox spacing="5">
                                <Label text="Port:" style="-fx-font-size: 11px; -fx-text-fill: #7f8c8d;"/>
                                <Label fx:id="status_portStatus" text="Disconnected" style="-fx-text-fill: #e74c3c; -fx-font-size: 11px; -fx-font-weight: bold;"/>
                            </HBox>
                            <HBox spacing="5">
                                <Label text="Device:" style="-fx-font-size: 11px; -fx-text-fill: #7f8c8d;"/>
                                <Label fx:id="status_deviceReady" text="Not Ready" style="-fx-text-fill: #e74c3c; -fx-font-size: 11px; -fx-font-weight: bold;"/>
                            </HBox>
                            <HBox spacing="5">
                                <Label text="Last Cmd:" style="-fx-font-size: 11px; -fx-text-fill: #7f8c8d;"/>
                                <Label fx:id="status_lastResponse" text="N/A" style="-fx-text-fill: #34495e; -fx-font-size: 11px;"/>
                            </HBox>
                        </VBox>
                    </VBox>

                    <!-- Quick Actions -->
                    <VBox spacing="6" style="-fx-background-color: white; -fx-border-color: #bdc3c7; -fx-border-radius: 6; -fx-padding: 10;" VBox.vgrow="ALWAYS">
                        <Label text="Quick Actions" style="-fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                        <Button fx:id="quick_resetBtn" text="Reset All" prefHeight="30"
                                style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-background-radius: 4;"/>
                        <Button fx:id="quick_testAllBtn" text="Test All" prefHeight="30"
                                style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-background-radius: 4;"/>
                        <Button fx:id="quick_clearLogsBtn" text="Clear Logs" prefHeight="30"
                                style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-background-radius: 4;"/>
                    </VBox>
                </VBox>
            </HBox>

            <!-- Bottom Controls Row -->
            <HBox spacing="10" VBox.vgrow="ALWAYS">
                <!-- Hopper Management -->
                <VBox spacing="8" style="-fx-background-color: white; -fx-border-color: #bdc3c7; -fx-border-radius: 6; -fx-padding: 10;" HBox.hgrow="ALWAYS">
                    <Label text="Hopper Management" style="-fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                    <HBox spacing="15">
                        <VBox spacing="5">
                            <Label text="Hopper 1" style="-fx-font-size: 11px; -fx-text-fill: #7f8c8d;"/>
                            <TextField fx:id="hopper_h1Field" prefWidth="60" style="-fx-background-radius: 4;"/>
                        </VBox>
                        <VBox spacing="5">
                            <Label text="Hopper 2" style="-fx-font-size: 11px; -fx-text-fill: #7f8c8d;"/>
                            <TextField fx:id="hopper_h2Field" prefWidth="60" style="-fx-background-radius: 4;"/>
                        </VBox>
                        <VBox spacing="5">
                            <Label text="Hopper 3" style="-fx-font-size: 11px; -fx-text-fill: #7f8c8d;"/>
                            <TextField fx:id="hopper_h3Field" prefWidth="60" style="-fx-background-radius: 4;"/>
                        </VBox>
                    </HBox>
                    <Button fx:id="hopper_coinChangeBtn" text="Coin Change"
                            style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-background-radius: 4;"/>
                </VBox>

                <!-- De-jamming Controls -->
                <VBox spacing="8" style="-fx-background-color: white; -fx-border-color: #bdc3c7; -fx-border-radius: 6; -fx-padding: 10;" HBox.hgrow="ALWAYS">
                    <Label text="De-jamming Controls" style="-fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                    <VBox spacing="5">
                        <Label text="Dejamming Cycles:" style="-fx-font-size: 11px; -fx-text-fill: #7f8c8d;"/>
                        <TextField fx:id="dejamming_cyclesField" prefWidth="80" style="-fx-background-radius: 4;"/>
                    </VBox>
                    <VBox spacing="5">
                        <Label text="Select Hoppers:" style="-fx-font-size: 11px; -fx-text-fill: #7f8c8d;"/>
                        <HBox spacing="10">
                            <CheckBox fx:id="dejamming_h1Check" text="H1"/>
                            <CheckBox fx:id="dejamming_h2Check" text="H2"/>
                            <CheckBox fx:id="dejamming_h3Check" text="H3"/>
                        </HBox>
                    </VBox>
                    <HBox spacing="10">
                        <Button fx:id="dejamming_motorBtn" text="De-jam Motor"
                                style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-background-radius: 4;"/>
                        <Button fx:id="dejamming_coinDumpBtn" text="Coin Dump"
                                style="-fx-background-color: #f39c12; -fx-text-fill: white; -fx-background-radius: 4;"/>
                    </HBox>
                </VBox>

                <!-- Auto Polling & Return Controls -->
                <VBox spacing="10" HBox.hgrow="ALWAYS">
                    <!-- Auto Polling -->
                    <VBox spacing="8" style="-fx-background-color: white; -fx-border-color: #bdc3c7; -fx-border-radius: 6; -fx-padding: 10;" VBox.vgrow="ALWAYS">
                        <Label text="Auto Polling" style="-fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                        <HBox spacing="10">
                            <Button fx:id="auto_startBtn" text="Start" prefWidth="80"
                                    style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-background-radius: 4;"/>
                            <Button fx:id="auto_stopBtn" text="Stop" prefWidth="80"
                                    style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-background-radius: 4;"/>
                        </HBox>
                    </VBox>

                    <!-- Return Controls -->
                    <VBox spacing="8" style="-fx-background-color: white; -fx-border-color: #bdc3c7; -fx-border-radius: 6; -fx-padding: 10;" VBox.vgrow="ALWAYS">
                        <Label text="Return Controls" style="-fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                        <VBox spacing="5">
                            <Label text="Escrow Control:" style="-fx-font-size: 11px; -fx-text-fill: #7f8c8d;"/>
                            <ComboBox fx:id="return_escrowCombo" prefWidth="140" style="-fx-background-radius: 4;"/>
                        </VBox>
                        <VBox spacing="5">
                            <Label text="Coin Return:" style="-fx-font-size: 11px; -fx-text-fill: #7f8c8d;"/>
                            <ComboBox fx:id="return_coinReturnCombo" prefWidth="140" style="-fx-background-radius: 4;"/>
                        </VBox>
                        <Button fx:id="diverter_ctrlBtn" text="Diverter Control"
                                style="-fx-background-color: #9b59b6; -fx-text-fill: white; -fx-background-radius: 4;"/>
                    </VBox>
                </VBox>

                <!-- Log Management -->
                <VBox spacing="8" style="-fx-background-color: white; -fx-border-color: #bdc3c7; -fx-border-radius: 6; -fx-padding: 10;" HBox.hgrow="ALWAYS">
                    <Label text="Log Management" style="-fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                    <VBox spacing="5">
                        <Label text="Delete logs older than:" style="-fx-font-size: 11px; -fx-text-fill: #7f8c8d;"/>
                        <HBox spacing="5">
                            <TextField fx:id="logs_daysField" prefWidth="50" promptText="Days"
                                       style="-fx-background-radius: 4;"/>
                            <Label text="days" style="-fx-text-fill: #7f8c8d; -fx-font-size: 11px;"/>
                        </HBox>
                    </VBox>
                    <Button fx:id="logs_controlBtn" text="Manage Logs"
                            style="-fx-background-color: #34495e; -fx-text-fill: white; -fx-background-radius: 4;"/>
                </VBox>
            </HBox>
        </VBox>
    </center>

    <bottom>
        <VBox spacing="5" style="-fx-background-color: #2c3e50; -fx-padding: 10;">
            <Label text="Activity Log" textFill="white" style="-fx-font-weight: bold;"/>
            <TextArea fx:id="main_logArea" prefHeight="120" wrapText="true"
                      style="-fx-background-radius: 4; -fx-control-inner-background: #1a1a1a; -fx-text-fill: #00ff00; -fx-font-family: 'Monospaced';"/>
        </VBox>
    </bottom>
</BorderPane>