<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane fx:id="anchorPane" styleClass="anchor-pane" stylesheets="@../../../../css/qrtoperations/replacement.css" xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.amay.tom.controller.CscOperationsViewController">



    <children>
          <!-- Text field for showing current device status -->
          <Text fx:id="currentStatus" layoutX="438.0" layoutY="44.0" strokeType="OUTSIDE" strokeWidth="0.0" styleClass="current-status" text="Replace Ticket">
              <font>
                  <Font size="25.0" />
              </font>
          </Text>
        <VBox alignment="CENTER" layoutX="10.0" layoutY="177.0" prefHeight="377.0" prefWidth="1057.0" spacing="10.0" styleClass="main-vbox" AnchorPane.leftAnchor="10.0" AnchorPane.rightAnchor="10.0">
            <children>

                <ImageView fx:id="imageView" fitHeight="200.0" fitWidth="200.0" pickOnBounds="true" preserveRatio="true" styleClass="image-view">
                    <image>
                        <Image fx:id="actualImage" url="@../../../../icons/ticket.png" />
                    </image>
                    <VBox.margin>
                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                    </VBox.margin>
                </ImageView>
                <GridPane alignment="CENTER" styleClass="main-gridpane" vgap="10.0" VBox.vgrow="ALWAYS">
                    <columnConstraints>
                        <ColumnConstraints halignment="CENTER" hgrow="SOMETIMES" percentWidth="0.0" prefWidth="200.0" />
                    </columnConstraints>
                    <rowConstraints>
                        <RowConstraints minHeight="10.0" percentHeight="0.0" valignment="CENTER" vgrow="SOMETIMES" />
                        <RowConstraints maxHeight="34.0" minHeight="8.0" prefHeight="34.0" vgrow="SOMETIMES" />
                    </rowConstraints>
                    <children>

                        <!-- Password field for user input -->
                        <TextField fx:id="ticketNumberField" prefWidth="200.0" promptText="Enter Ticket No" styleClass="ticket-number-field" />

                        <!-- Button -->
                        <Button fx:id="conformButton" mnemonicParsing="false" onAction="#onClickConform" styleClass="confirm-button" text="Confirm" GridPane.rowIndex="1">
                        </Button>
                    </children>
                    <VBox.margin>
                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                    </VBox.margin>
                    <padding>
                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                    </padding>
                </GridPane>
            </children>
        </VBox>
    </children>
    <opaqueInsets>
        <Insets />
    </opaqueInsets>
</AnchorPane>
