<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.StackPane?>

<!--            prefHeight="480.0" prefWidth="640.0"-->

<AnchorPane fx:id="mainRootPane" maxHeight="1024.0" maxWidth="1280.0" minHeight="1024.0" minWidth="1280.0" prefHeight="1024.0" prefWidth="1280.0" style="-fx-background-color;" styleClass="bg-header" stylesheets="styles.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.amay.tom.pdu.controller.PDUController">
   <children>
<!--      <GridPane prefHeight="480.0" prefWidth="640.0">-->
       <GridPane fx:id="mainGrid" maxHeight="1024" maxWidth="1280" minHeight="1024" minWidth="1280" prefHeight="1024" prefWidth="1280" style=" -fx-background-color;">
        <columnConstraints>
          <ColumnConstraints halignment="CENTER" hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
        </columnConstraints>
        <rowConstraints>
          <RowConstraints maxHeight="251.0" minHeight="10.0" percentHeight="20.0" prefHeight="251.0" vgrow="SOMETIMES" />
          <RowConstraints maxHeight="657.0" minHeight="10.0" prefHeight="657.0" vgrow="SOMETIMES" />
          <RowConstraints minHeight="10.0" percentHeight="16.0" prefHeight="30.0" vgrow="SOMETIMES" />
        </rowConstraints>
          <children>
              <fx:include fx:id="header" source="header.fxml" GridPane.columnIndex="0" GridPane.rowIndex="0" />
              <StackPane fx:id="stackPane" style=" -fx-background-color;" GridPane.columnIndex="0" GridPane.rowIndex="1">
                  <!--                  <fx:include source="success_screen.fxml" />-->
                  <!--                  <fx:include source="error_screen.fxml" />-->
                  <!--                  <fx:include source="emergency_screen.fxml" />-->
                  <fx:include source="welcome_screen.fxml" />
              </StackPane>
              <fx:include source="footer.fxml" style=" -fx-background-color;" GridPane.columnIndex="0" GridPane.rowIndex="2" />
          </children>
      </GridPane>
   </children>
</AnchorPane>
