<HBox fx:id="hbox" alignment="BASELINE_RIGHT" spacing="10" styleClass="hbox-background" stylesheets="@../../../../css/components/status.css" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.amay.tom.controller.components.StatusBottomBarView">


        <Button fx:id="cashDrawerConnectedImage" styleClass="status-button" visible="false">
                <graphic>
                        <ImageView fitHeight="30" fitWidth="30">
                                <Image url="@../../../../images/printer.png" />
                        </ImageView>
                </graphic>
        </Button>
   <GridPane alignment="CENTER">
     <columnConstraints>
       <ColumnConstraints hgrow="SOMETIMES" />
       <ColumnConstraints hgrow="SOMETIMES" />
     </columnConstraints>
     <rowConstraints>
       <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
     </rowConstraints>
      <children>
         <Text strokeType="OUTSIDE" strokeWidth="0.0" text="Software Version :" />
         <Text fx:id="softwareVersion" strokeType="OUTSIDE" strokeWidth="0.0" text="Text" GridPane.columnIndex="1" />
      </children>
   </GridPane>

