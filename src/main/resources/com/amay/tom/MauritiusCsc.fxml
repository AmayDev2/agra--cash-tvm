<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.amay.tom.controller.MauritiusCscController">

    <!-- TOP TOOLBAR -->
    <top>
        <VBox spacing="10">

            <!-- Row 1 -->
            <HBox spacing="10">
                <ComboBox fx:id="comboComPort" prefWidth="100" />

                <Button onAction="#onOpenPort" text="Open Port" />
                <Button onAction="#onClosePort" text="Close Port" />
                <Button onAction="#onGetStatus" text="Get Status" />
                <Button onAction="#onMotorTest" text="Motor Test" />

                <ComboBox fx:id="comboMotor" prefWidth="140" />

                <Pane HBox.hgrow="ALWAYS" />

                <Button onAction="#onExit" text="Exit" />
            </HBox>

            <!-- Row 2 (Feed Ticket + Radio Options) -->
            <HBox spacing="15">

                <Button onAction="#onFeedTicket" text="Feed Ticket" />

                <!-- Issue Options -->
                <HBox spacing="5.0" style="-fx-border-color: grey; -fx-border-radius: 4;">
                    <RadioButton fx:id="rbIssuePassenger" text="issue to passenger">
                  <toggleGroup>
                     <ToggleGroup fx:id="group1" />
                  </toggleGroup></RadioButton>
                    <RadioButton fx:id="rbIssueReject" text="issue to Reject Bin" toggleGroup="$group1" />
                    <RadioButton fx:id="rbAutoFeed" text="auto feed">
                  <toggleGroup>
                     <ToggleGroup fx:id="group2" />
                  </toggleGroup></RadioButton>
                    <RadioButton fx:id="rbManualFeed" text="manual feed" toggleGroup="$group2" />
                    <Button onAction="#onTicketResult" text="Ticket Result">
                  <HBox.margin>
                     <Insets />
                  </HBox.margin></Button>
               <padding>
                  <Insets bottom="15.0" left="10.0" right="10.0" top="15.0" />
               </padding>
                </HBox>




            </HBox>

            <!-- Row 3 (Right side tools) -->
            <HBox spacing="15">

                <Button onAction="#onGetVersion" text="Get Version" />
                <Button onAction="#onChangeTicketBox" text="Change Ticket Box" />
                <Button onAction="#onClearInfo" text="Clear Info" />

                <Label text="Input log save days:" />
                <TextField fx:id="txtLogDays" prefWidth="50" />

                <Button onAction="#onDeleteLogs" text="Delete Log Files" />
            </HBox>

        </VBox>
    </top>

    <!-- CENTER LOG OUTPUT -->
    <center>
        <TextArea fx:id="txtLog" editable="false" wrapText="false" />
    </center>

</BorderPane>
