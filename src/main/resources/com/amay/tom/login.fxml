<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane fx:id="anchorPane" maxWidth="1024.0" minWidth="1024.0" prefHeight="768.0" prefWidth="1024.0" styleClass="anchor-pane" stylesheets="@/css/login.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.amay.tom.controller.LoginController">

    <VBox fx:id="vbox" alignment="TOP_CENTER" spacing="20" styleClass="vbox" AnchorPane.bottomAnchor="10" AnchorPane.leftAnchor="10" AnchorPane.rightAnchor="10" AnchorPane.topAnchor="10">



        <!-- Top Section -->
        <HBox alignment="CENTER" spacing="80" style="-fx-padding: 20;">
            <!-- Equipment & Station Info -->
            <GridPane hgap="10" vgap="15">
                <columnConstraints>
                    <ColumnConstraints halignment="RIGHT" minWidth="120" />
                    <ColumnConstraints halignment="CENTER" prefWidth="20" />
                    <ColumnConstraints halignment="LEFT" minWidth="120" />
                </columnConstraints>
                <children>
                    <Label text="Equipment ID" textFill="WHITE" GridPane.columnIndex="0" GridPane.rowIndex="0">
                        <font><Font name="System Bold" size="18" /></font>
                    </Label>
                    <Label text=":" textFill="WHITE" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                    <Label fx:id="equipmentId" text="0000000" textFill="WHITE" GridPane.columnIndex="2" GridPane.rowIndex="0">
                        <font><Font name="System Bold" size="18" /></font>
                    </Label>

                    <Label text="Station Name" textFill="WHITE" GridPane.columnIndex="0" GridPane.rowIndex="1">
                        <font><Font name="System Bold" size="18" /></font>
                    </Label>
                    <Label text=":" textFill="WHITE" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                    <Label fx:id="csn" text="000000" textFill="WHITE" GridPane.columnIndex="2" GridPane.rowIndex="1">
                        <font><Font name="System Bold" size="18" /></font>
                    </Label>
                </children>
            <rowConstraints>
               <RowConstraints />
               <RowConstraints />
            </rowConstraints>
            </GridPane>

            <!-- Date & Time -->
            <GridPane alignment="CENTER" hgap="15" vgap="15">
                <columnConstraints>
                    <ColumnConstraints halignment="RIGHT" minWidth="40" />
                    <ColumnConstraints halignment="LEFT" minWidth="120" />
                </columnConstraints>
                <children>
                    <ImageView fx:id="calendarIcon" fitHeight="30" fitWidth="30" preserveRatio="true" GridPane.columnIndex="0" GridPane.rowIndex="0">
                        <Image url="@../../../icons/assets_tom/Calendar.png" />
                    </ImageView>
                    <Label fx:id="dateLabel" text="DD MM YYYY" textFill="WHITE" GridPane.columnIndex="1" GridPane.rowIndex="0">
                        <font><Font name="System Bold" size="18" /></font>
                    </Label>

                    <ImageView fx:id="clockIcon" fitHeight="30" fitWidth="30" preserveRatio="true" GridPane.columnIndex="0" GridPane.rowIndex="1">
                        <Image url="@../../../icons/assets_tom/Clock.png" />
                    </ImageView>
                    <Label fx:id="timeLabel" text="HH:MM:SS" textFill="WHITE" GridPane.columnIndex="1" GridPane.rowIndex="1">
                        <font><Font name="System Bold" size="18" /></font>
                    </Label>
                </children>
            <rowConstraints>
               <RowConstraints />
               <RowConstraints />
            </rowConstraints>
            </GridPane>
        </HBox>


        <!-- Logo Center -->
        <Pane fx:id="logoPane" prefHeight="120" prefWidth="148.0" style="-fx-background-image: url('@../../images/umprc_logo.png'); -fx-background-size: contain; -fx-background-repeat: no-repeat; -fx-background-position: center;"/>


        <!-- Status Message -->
        <Label fx:id="csn1" alignment="CENTER" style="-fx-background-color: rgba(255,255,255,0.1); -fx-padding: 15; -fx-background-radius: 8;" text="OUT OF WORKING HOURS" textFill="WHITE">
            <font><Font name="System Bold" size="20" /></font>
        </Label>
    </VBox>
</AnchorPane>
