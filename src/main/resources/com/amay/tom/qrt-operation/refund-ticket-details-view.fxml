<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="700.0" prefWidth="900.0" styleClass="main-container" stylesheets="@../../../../css/qrtoperations/refund.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.amay.tom.controller.RefundTicketDetailsController">

    <VBox alignment="CENTER" spacing="20.0" styleClass="content-box" AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="20.0">

        <Text styleClass="header-text" text="Ticket Details" />

        <GridPane alignment="CENTER" hgap="15" vgap="15">
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </padding>

            <!-- Ticket Information -->
            <Label styleClass="detail-label" text="Ticket Number:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
            <Text fx:id="ticketNumber" styleClass="detail-text" GridPane.columnIndex="1" GridPane.rowIndex="0" />

            <Label styleClass="detail-label" text="Payment Type" GridPane.columnIndex="0" GridPane.rowIndex="1" />
            <Text fx:id="paymentType" styleClass="detail-text" GridPane.columnIndex="1" GridPane.rowIndex="1" />

            <Label styleClass="detail-label" text="Source:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
            <Text fx:id="source" styleClass="detail-text" GridPane.columnIndex="1" GridPane.rowIndex="2" />

            <Label styleClass="detail-label" text="Destination:" GridPane.columnIndex="0" GridPane.rowIndex="3" />
            <Text fx:id="destination" styleClass="detail-text" GridPane.columnIndex="1" GridPane.rowIndex="3" />

            <Label styleClass="detail-label" text="Fare:" GridPane.columnIndex="0" GridPane.rowIndex="4" />
            <Text fx:id="fare" styleClass="detail-text" GridPane.columnIndex="1" GridPane.rowIndex="4" />

            <Label styleClass="detail-label" text="Type:" GridPane.columnIndex="0" GridPane.rowIndex="5" />
            <Text fx:id="type" styleClass="detail-text" GridPane.columnIndex="1" GridPane.rowIndex="5" />

            <Label styleClass="detail-label" text="Date/Time:" GridPane.columnIndex="0" GridPane.rowIndex="6" />
            <Text fx:id="dateTime" styleClass="detail-text" GridPane.columnIndex="1" GridPane.rowIndex="6" />

<!--            <Label styleClass="detail-label" text="Valid Until:" GridPane.columnIndex="0" GridPane.rowIndex="7" />-->
<!--            <Text fx:id="validUntil" styleClass="detail-text" GridPane.columnIndex="1" GridPane.rowIndex="7" />-->

<!--            <Label styleClass="detail-label" text="Status:" GridPane.columnIndex="0" GridPane.rowIndex="8" />-->
<!--            <Text fx:id="status" styleClass="detail-text" GridPane.columnIndex="1" GridPane.rowIndex="8" />-->

            <Label styleClass="detail-label" text="Description :" GridPane.columnIndex="0" GridPane.rowIndex="7" />
            <Text fx:id="description" styleClass="detail-text" GridPane.columnIndex="1" GridPane.rowIndex="7" />
         <columnConstraints>
            <ColumnConstraints />
            <ColumnConstraints />
         </columnConstraints>
         <rowConstraints>
            <RowConstraints />
            <RowConstraints />
            <RowConstraints />
            <RowConstraints />
            <RowConstraints />
            <RowConstraints />
            <RowConstraints />
            <RowConstraints />
         </rowConstraints>

            <!-- QR Code Display -->
<!--            <ImageView fx:id="qrCodeImage" fitHeight="200.0" fitWidth="200.0" -->
<!--                      GridPane.columnIndex="2" GridPane.rowIndex="0" -->
<!--                      GridPane.rowSpan="4" styleClass="qr-code"/>-->
        </GridPane>

        <Button fx:id="refundButton" onAction="#onRefundClick" styleClass="refund-button" text="Process Refund" />
    </VBox>
</AnchorPane>
