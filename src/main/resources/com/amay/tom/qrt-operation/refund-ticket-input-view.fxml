<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.amay.tom.controller.RefundTicketInputController"
            prefHeight="600.0" prefWidth="800.0"
            stylesheets="@../../../../css/qrtoperations/refund.css"
            styleClass="main-container">
    
    <VBox alignment="CENTER" spacing="20.0" AnchorPane.bottomAnchor="20.0" 
          AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" 
          AnchorPane.topAnchor="20.0" styleClass="content-box">
        
        <Text styleClass="header-text" text="Ticket Refund" />
        
        <GridPane hgap="10" vgap="10" alignment="CENTER">
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
            </padding>
            
            <Label text="Ticket Number:" GridPane.columnIndex="0" GridPane.rowIndex="0" 
                   styleClass="input-label"/>
            <TextField fx:id="ticketNumberField" GridPane.columnIndex="1" GridPane.rowIndex="0" 
                      prefWidth="300.0" styleClass="input-field"/>
            
            <Button fx:id="searchButton" text="Search" onAction="#onSearchClick" 
                    GridPane.columnIndex="1" GridPane.rowIndex="1" 
                    styleClass="search-button"/>
        </GridPane>
    </VBox>
</AnchorPane> 