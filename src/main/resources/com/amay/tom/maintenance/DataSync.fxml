<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/17.0.12"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.amay.tom.controller.DataSync"
           styleClass="root">

    <VBox alignment="TOP_CENTER"
          spacing="20"
          fx:id="root"
          maxWidth="640" maxHeight="420"
          prefWidth="640" prefHeight="420"
          styleClass="main-box"
          StackPane.alignment="CENTER">

        <!-- Title -->
        <Label styleClass="dashboard-title"
               text="Data Synchronization Status"
               maxWidth="Infinity"
               alignment="CENTER" />

        <!-- Main Grid -->
        <GridPane alignment="CENTER"
                  hgap="20" vgap="15"
                  styleClass="grid-pane"
                  VBox.vgrow="ALWAYS">

            <columnConstraints>
                <ColumnConstraints percentWidth="33.33" hgrow="SOMETIMES"/>
                <ColumnConstraints percentWidth="33.33" hgrow="SOMETIMES"/>
                <ColumnConstraints percentWidth="33.33" hgrow="SOMETIMES"/>
            </columnConstraints>

            <rowConstraints>
                <RowConstraints percentHeight="12"/>
                <RowConstraints percentHeight="17"/>
                <RowConstraints percentHeight="17"/>
                <RowConstraints percentHeight="17"/>
                <RowConstraints percentHeight="17"/>
                <RowConstraints percentHeight="12"/>
            </rowConstraints>

            <!-- Header -->
            <Label styleClass="label" text="Metric" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
            <Label styleClass="label" text="CCU" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
            <Label styleClass="label" text="SCU" GridPane.columnIndex="2" GridPane.rowIndex="0"/>

            <!-- Total Data -->
            <Label styleClass="h2" text="Total (No. of Files)" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
            <VBox alignment="CENTER" styleClass="totalData" GridPane.columnIndex="1" GridPane.rowIndex="1">
                <Label fx:id="totalDataCount1" styleClass="h1" text="N/A"/>
                <Label styleClass="h3" text="All Records"/>
            </VBox>
            <VBox alignment="CENTER" styleClass="totalData" GridPane.columnIndex="2" GridPane.rowIndex="1">
                <Label fx:id="totalDataCount2" styleClass="h1" text="N/A"/>
                <Label styleClass="h3" text="All Records"/>
            </VBox>

            <!-- Online Data -->
            <Label styleClass="h2" text="Online (Synced)" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
            <VBox alignment="CENTER" styleClass="onlineData" GridPane.columnIndex="1" GridPane.rowIndex="2">
                <Label fx:id="onlineDataCountCCU" styleClass="h1" text="N/A"/>
                <Label styleClass="h3" text="Real-time Backed Up"/>
            </VBox>
            <VBox alignment="CENTER" styleClass="onlineData" GridPane.columnIndex="2" GridPane.rowIndex="2">
                <Label fx:id="onlineDataCountSCU" styleClass="h1" text="N/A"/>
                <Label styleClass="h3" text="Real-time Backed Up"/>
            </VBox>

            <!-- Offline Data -->
            <Label styleClass="h2" text="Offline (Not Synced Yet)" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
            <VBox alignment="CENTER" styleClass="offlineData" GridPane.columnIndex="1" GridPane.rowIndex="3">
                <Label fx:id="offlineDataCountCCU" styleClass="h1" text="N/A"/>
                <Label styleClass="h3" text="Pending Uploads"/>
            </VBox>
            <VBox alignment="CENTER" styleClass="offlineData" GridPane.columnIndex="2" GridPane.rowIndex="3">
                <Label fx:id="offlineDataCountSCU" styleClass="h1" text="N/A"/>
                <Label styleClass="h3" text="Pending Uploads"/>
            </VBox>

            <!-- Last Sync -->
            <Label styleClass="h2" text="Last Sync" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
            <Label fx:id="lastSyncTimestampCCU" styleClass="timestamp" text="N/A"
                   GridPane.columnIndex="1" GridPane.rowIndex="4"/>
            <Label fx:id="lastSyncTimestampSCU" styleClass="timestamp" text="N/A"
                   GridPane.columnIndex="2" GridPane.rowIndex="4"/>

            <!-- Buttons -->
            <Button text="Back" onAction="#onBack"
                    GridPane.columnIndex="1" GridPane.rowIndex="5"
                    GridPane.halignment="CENTER"
                    prefWidth="120" prefHeight="35"/>

            <Label fx:id="syncStatusLabel" text="Go online to sync data"
                   visible="false" alignment="CENTER"
                   styleClass="sync-label"
                   GridPane.columnIndex="2" GridPane.rowIndex="5"/>
        </GridPane>

        <padding>
            <Insets top="15" right="30" bottom="15" left="30"/>
        </padding>
    </VBox>
</StackPane>
