<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<GridPane alignment="CENTER" prefHeight="480.0" prefWidth="640.0" styleClass="background" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.amay.tvm.controller.ApplicationController">

    <!-- Columns -->
    <columnConstraints>
        <ColumnConstraints minWidth="10.0" percentWidth="50.0" prefWidth="100.0" />
        <ColumnConstraints minWidth="10.0" percentWidth="50.0" prefWidth="100.0" />
    </columnConstraints>

    <!-- Rows -->
    <rowConstraints>
        <RowConstraints minHeight="10.0" percentHeight="17.0" prefHeight="116.0" valignment="CENTER" />
        <RowConstraints minHeight="10.0" percentHeight="20.0" prefHeight="116.0" valignment="CENTER" />
        <RowConstraints minHeight="10.0" percentHeight="20.0" prefHeight="116.0" valignment="CENTER" />
        <RowConstraints minHeight="139.0" percentHeight="35.0" prefHeight="141.0" valignment="CENTER" />
    </rowConstraints>

    <children>
        <!-- Title -->
        <Label prefHeight="35.0" prefWidth="142.0" text="System Restart" GridPane.columnSpan="2" GridPane.halignment="CENTER">
            <GridPane.margin>
                <Insets left="20.0" />
            </GridPane.margin>
        </Label>

        <!-- Buttons -->
        <Button mnemonicParsing="false" onAction="#onSystemRestart" prefHeight="35.0" prefWidth="200.0" text="System Restart" GridPane.halignment="CENTER" GridPane.rowIndex="1" />
        <Button mnemonicParsing="false" onAction="#onSystemShutdown" prefHeight="35.0" prefWidth="200.0" text="System Shutdown" GridPane.columnIndex="1" GridPane.halignment="CENTER" GridPane.rowIndex="1" />
        <Button mnemonicParsing="false" onAction="#onApplicationRestart" prefHeight="35.0" prefWidth="200.0" text="Application Restart" GridPane.halignment="CENTER" GridPane.rowIndex="2" />
        <Button mnemonicParsing="false" onAction="#onApplicationClose" prefHeight="35.0" prefWidth="200.0" text="Application Close" GridPane.columnIndex="1" GridPane.halignment="CENTER" GridPane.rowIndex="2" />
        <Button mnemonicParsing="false" onAction="#onBack" prefHeight="35.0" prefWidth="140.0" text="Back" GridPane.columnSpan="2" GridPane.halignment="CENTER" GridPane.rowIndex="3" />
    </children>

</GridPane>
