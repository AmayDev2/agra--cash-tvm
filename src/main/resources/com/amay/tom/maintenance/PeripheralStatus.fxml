<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.geometry.Insets?>
<VBox prefHeight="350.0" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" styleClass="background" fx:controller="com.amay.tvm.controller.PeripheralStatusController">
    <children>
        <TableView fx:id="periStatusTable" prefHeight="300.0" prefWidth="1000.0">
            <columns>
                <TableColumn fx:id="colDevice" maxWidth="500.0" minWidth="500.0" prefWidth="500.0" text="Device" />
                <TableColumn fx:id="colStatus" maxWidth="500.0" minWidth="500.0" prefWidth="500.0" text="Status" />
            </columns>
        </TableView>
    </children>
    <Button onAction="#onBack" prefHeight="39.0" prefWidth="140.0" text="Back" GridPane.halignment="CENTER" GridPane.rowIndex="3" />

</VBox>

