<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<GridPane prefHeight="480.0" styleClass="background" stylesheets="@../pdu/styles.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.amay.tvm.controller.PeripheralStatusController">
   <columnConstraints>
      <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" />
   </columnConstraints>
   <rowConstraints>
      <RowConstraints minHeight="10.0" percentHeight="90.0" vgrow="SOMETIMES" />
      <RowConstraints minHeight="10.0" percentHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
   </rowConstraints>
   <children>
      <VBox fx:id="root" alignment="CENTER" prefHeight="480.0" prefWidth="640.0" styleClass="background" stylesheets="@../pdu/styles.css">
      
                <TableView fx:id="periStatusTable" maxWidth="-Infinity" prefHeight="387.0" prefWidth="585.0">
              <columns>
                  <TableColumn fx:id="colDevice" maxWidth="300.0" minWidth="300.0" prefWidth="300.0" text="Device" />
                  <TableColumn fx:id="colStatus" maxWidth="300.0" minWidth="300.0" prefWidth="300.0" text="Status" />
              </columns>
          </TableView>
      
      </VBox>
       <Button fx:id="backButton" onAction="#onBack" styleClass="backButton" text="Back" GridPane.halignment="CENTER" GridPane.rowIndex="1">
         <GridPane.margin>
            <Insets bottom="10.0" />
         </GridPane.margin></Button>
   </children>
</GridPane>
